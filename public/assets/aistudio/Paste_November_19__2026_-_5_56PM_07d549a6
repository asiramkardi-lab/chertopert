from app.schemas.recognition import Candle, RecognitionResponse

def count_directional_candles(candles: list[Candle], direction: str) -> int:
    count = 0
    for c in candles:
        if direction == "up" and c.close > c.open:
            count += 1
        elif direction == "down" and c.close < c.open:
            count += 1
    return count

def has_strong_trend(candles: list[Candle], window: int = 3) -> bool:
    """Check if last `window` candles show strong directional movement."""
    if len(candles) < window:
        return False
    ups = sum(1 for c in candles[-window:] if c.close > c.open)
    downs = sum(1 for c in candles[-window:] if c.close < c.open)
    return max(ups, downs) >= window - 1  # at most 1 counter-candle

def validate_minimum_candles(
    candles: list[Candle],
    direction: str,
    check_shadow: bool = True
) -> RecognitionResponse:
    directional = count_directional_candles(candles, direction)
    
    if directional >= 3:
        return RecognitionResponse(
            valid_wave=True,
            wave_count=1,
            degree="SIMPLE",
            warnings=[]
        )
    
    # Shadow exception
    if check_shadow and has_strong_trend(candles, window=3):
        # Check if there's a directional wick
        for c in candles:
            if direction == "up" and c.high > max(c.open, c.close) * 1.01:
                return RecognitionResponse(
                    valid_wave=True,
                    wave_count=1,
                    degree="SIMPLE",
                    warnings=["Shadow exception used (strong trend)"]
                )
            if direction == "down" and c.low < min(c.open, c.close) * 0.99:
                return RecognitionResponse(
                    valid_wave=True,
                    wave_count=1,
                    degree="SIMPLE",
                    warnings=["Shadow exception used (strong trend)"]
                )
    
    return RecognitionResponse(
        valid_wave=False,
        wave_count=0,
        degree="SIMPLE",
        warnings=[f"Only {directional} directional candles (minimum 3)"]
    )
