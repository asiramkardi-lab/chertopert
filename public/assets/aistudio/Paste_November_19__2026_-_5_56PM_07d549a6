from app.schemas.fibonacci import MotiveWave, FibLevel, FibResponse

EXTENSION_LEVELS = [61.8, 100.0, 127.0, 161.8, 261.8, 423.6]

def compute_extension(wave: MotiveWave) -> FibResponse:
    """Compute extension levels (Y→X orientation)."""
    levels = []
    
    for pct in EXTENSION_LEVELS:
        ratio = pct / 100.0
        if wave.direction == "up":
            price = wave.end_price + wave.length * (ratio - 1.0)
        else:
            price = wave.end_price - wave.length * (ratio - 1.0)
        
        # Extension levels: sr_importance typically strong at 100, 161.8, 261.8
        sr = "very_strong" if pct in [100.0, 161.8] else "strong" if pct in [127.0, 261.8] else "moderate"
        
        levels.append(FibLevel(
            level=pct,
            price=round(price, 4),
            sr_importance=sr,
            id_importance=True,
            acceleration=False
        ))
    
    return FibResponse(
        levels=levels,
        draw_from=wave.end_price,   # Y→X: start from end
        draw_to=wave.start_price,   # Y→X: to start
        orientation="Y→X",
        mode="extension"
    )
