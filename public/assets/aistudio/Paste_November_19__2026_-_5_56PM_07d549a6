from app.schemas.triangle_advanced import Wave

def validate_retracement(waves: list[Wave]) -> tuple[bool, str]:
    """Validate 50% retracement rule."""
    if len(waves) < 2:
        return False, "Need at least 2 waves"
    
    retracements = []
    for i in range(1, len(waves)):
        prev = waves[i-1]
        curr = waves[i]
        if prev.length == 0:
            continue
        # Retracement: current wave recovers >= 50% of previous
        # For triangle: wave alternates direction
        retracement = curr.length / prev.length
        retracements.append(retracement)
    
    if not retracements:
        return False, "Cannot compute retracements"
    
    ideal_count = sum(1 for r in retracements if r >= 0.5)
    total = len(retracements)
    
    if ideal_count == total:
        return True, f"All {total} waves retrace >= 50% (ideal)"
    elif ideal_count >= total * 0.6:
        return False, f"{ideal_count}/{total} waves retrace >= 50% (mostly ideal)"
    else:
        return False, f"{ideal_count}/{total} waves retrace >= 50% (weak)"
