from app.schemas.entry import Wave, EntryStep

PRIME_ZONES = {
    0.618: "61.8% (ideal wave 2 reversal)",
    0.786: "78.6% (wave 2 with wave 1 extension + acceleration)"
}

def identify_prime_zone(wave_1: Wave, current_price: float, tolerance: float = 0.01) -> tuple[str, float] | None:
    """Identify if current price is at a prime zone."""
    if wave_1.length == 0:
        return None
    
    if wave_1.end_price > wave_1.start_price:
        base = wave_1.end_price
        direction = -1
    else:
        base = wave_1.end_price
        direction = 1
    
    for ratio, name in PRIME_ZONES.items():
        target = base + direction * wave_1.length * ratio
        if abs(current_price - target) / wave_1.length <= tolerance:
            return name, target
    
    return None
