from app.schemas.fractal import (
    DegreeAssignmentRequest, DegreeAssignmentResponse
)

MAX_DEGREES = {"daily": 4, "weekly": 3, "monthly": 2}
DEGREE_LABELS = ["V", "W", "BOLD", "SIMPLE"]

def assign_degrees(req: DegreeAssignmentRequest) -> DegreeAssignmentResponse:
    max_deg = MAX_DEGREES[req.timeframe]
    if req.nesting_depth <= max_deg:
        return DegreeAssignmentResponse(
            degrees=DEGREE_LABELS[:req.nesting_depth],
            dropped_levels=0,
            reason=f"Nesting depth {req.nesting_depth} within limit for {req.timeframe}"
        )
    else:
        return DegreeAssignmentResponse(
            degrees=DEGREE_LABELS[:max_deg],
            dropped_levels=req.nesting_depth - max_deg,
            reason=f"Nesting depth {req.nesting_depth} exceeds {max_deg} for {req.timeframe}; "
                   f"dropped {req.nesting_depth - max_deg} smallest degree(s)"
        )

def promote_degrees(current: list[str]) -> list[str]:
    """Promote all labels by one degree and drop the smallest."""
    promoted = []
    for d in current:
        if d == "SIMPLE":
            continue  # drop
        elif d == "BOLD":
            promoted.append("W")
        elif d == "W":
            promoted.append("V")
        elif d == "V":
            promoted.append("V")  # highest, stays
    return promoted
