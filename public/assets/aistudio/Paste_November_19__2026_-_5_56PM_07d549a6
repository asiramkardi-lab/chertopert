from app.schemas.zigzag import Wave

def classify_by_wave_c(a: Wave, c: Wave) -> tuple[str, str]:
    """Classify by C size relative to A (Fibonacci projection).
    
    Uses simple length ratio as approximation of Fibonacci projection.
    Truncated: 61.8-100% A
    Normal: 100-161.8% A
    Extended: > 161.8% A
    """
    a_length = a.length
    c_length = c.length
    
    if a_length == 0:
        return "Invalid", "Zero-length wave A"
    
    ratio = c_length / a_length
    
    if ratio < 0.618:
        return "Invalid", f"C/A ratio {ratio:.3f} < 0.618 (below truncated minimum)"
    elif ratio <= 1.0:
        return "Truncated", f"C/A ratio {ratio:.3f} (61.8-100%)"
    elif ratio <= 1.618:
        return "Normal", f"C/A ratio {ratio:.3f} (100-161.8%)"
    else:
        return "Extended", f"C/A ratio {ratio:.3f} (>161.8%)"
