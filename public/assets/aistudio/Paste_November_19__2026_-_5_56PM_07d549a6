FREQUENCY = {"2": "20%", "4": "50%", "B": "30%", "5": "rare"}

def analyze_advanced_triangle(req: TriangleRequest) -> TriangleResponse:
    notes = []
    warnings = []
    
    if len(req.waves) != 5:
        return TriangleResponse(confidence=0.0, warnings=["Need 5 waves A-E"])
    
    # Step 1: Classify
    primary, secondary, cls_msg = classify_six_types(req.waves)
    if primary == "Invalid":
        return TriangleResponse(confidence=0.0, warnings=[cls_msg])
    notes.append(cls_msg)
    
    # Step 2: Retracement
    ret_ideal, ret_msg = validate_retracement(req.waves)
    if not ret_ideal:
        warnings.append(ret_msg)
    notes.append(ret_msg)
    
    # Step 3: Ideal completion (simplified - use E end as end_idx)
    ideal_comp, ideal_msg = detect_ideal_completion(
        req.waves, req.waves[4].end_price if req.waves[4].end_price else 0, 1
    )
    notes.append(ideal_msg)
    
    # Step 4: Approach
    approach, risk, app_msg = recommend_approach(
        req.breakout_direction, req.pullback_present
    )
    notes.append(app_msg)
    
    # Step 5: Ending Triangle
    ending, ending_msg = detect_ending_triangle(req.waves, req.wave_position)
    if ending:
        warnings.append("Ending Triangle: expect strong reversal")
    notes.append(ending_msg)
    
    # Confidence
    confidence = 0.8
    if not ret_ideal:
        confidence -= 0.15
    if primary == "Expanding":
        confidence -= 0.1
        warnings.append("Expanding Triangle is rarer; verify")
    if req.breakout_direction is None:
        confidence -= 0.2
    
    return TriangleResponse(
        type=primary,
        secondary_types=secondary,
        ideal_retracement=ret_ideal,
        ideal_completion=ideal_comp,
        approach=approach,
        risk=risk,
        ending_triangle=ending,
        frequency=FREQUENCY.get(req.wave_position),
        confidence=max(0.0, min(1.0, confidence)),
        warnings=warnings,
        notes=notes
    )
