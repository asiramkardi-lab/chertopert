from app.schemas.complex_adv import ComplexRequest, ComplexResponse

STANDARD_COMBINATIONS = {
    ("Z", "Z"): "Z-X-Z", ("Z", "F"): "Z-X-F", ("Z", "Tri"): "Z-X-T",
    ("F", "Z"): "F-X-Z", ("F", "F"): "F-X-F", ("F", "Tri"): "F-X-T",
    ("Tri", "Z"): "T-X-Z", ("Tri", "F"): "T-X-F", ("Tri", "Tri"): "T-X-T",
}

MAIN_COMBINATIONS = {
    ("I", "Z"): "I-X-Z", ("I", "F"): "I-X-F", ("I", "Tri"): "I-X-T",
    ("G", "Z"): "G-X-Z", ("G", "F"): "G-X-F", ("G", "Tri"): "G-X-T",
    ("T", "Z"): "T-term-X-Z", ("T", "F"): "T-term-X-F",
}

def detect_standard(req: ComplexRequest) -> tuple[str, bool]:
    """Detect standard (2 patterns) or main-pattern combinations."""
    if len(req.components) != 2:
        return "", False
    
    key = (req.components[0].abbreviation, req.components[1].abbreviation)
    
    if key in STANDARD_COMBINATIONS:
        return STANDARD_COMBINATIONS[key], True
    if key in MAIN_COMBINATIONS:
        return MAIN_COMBINATIONS[key], True
    
    # Unknown combo
    return f"{key[0]}-X-{key[1]}", True
