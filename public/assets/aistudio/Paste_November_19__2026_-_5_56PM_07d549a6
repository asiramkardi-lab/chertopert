from app.schemas.zigzag import Wave

def validate_c_over_b(a: Wave, b: Wave, c: Wave, tolerance: float = 0.001) -> tuple[bool, str]:
    """Validate C >= 100% of B (strict rule)."""
    # For uptrend (a up, b down, c up) or downtrend
    if a.end_price > a.start_price:
        # Uptrend: B is down, C is up
        b_length = abs(b.start_price - b.end_price)
        c_recovery = c.end_price - b.end_price  # from B's end
        if c_recovery < b_length * (1 - tolerance):
            return False, f"C ({c_recovery:.2f}) < 100% of B ({b_length:.2f})"
    else:
        # Downtrend
        b_length = abs(b.end_price - b.start_price)
        c_recovery = b.end_price - c.end_price
        if c_recovery < b_length * (1 - tolerance):
            return False, f"C ({c_recovery:.2f}) < 100% of B ({b_length:.2f})"
    
    return True, "C >= 100% B validated"
