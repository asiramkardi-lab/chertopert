from app.schemas.diagonal import CorrectionRequest, CorrectionResponse

def predict_correction(req: CorrectionRequest) -> CorrectionResponse:
    """Predict post-diagonal correction depth and target."""
    if req.diagonal_type == "anti":
        depth_range = ">61.8%"
        confidence = 0.75
    elif req.diagonal_type == "ending":
        depth_range = "50-61.8%"
        confidence = 0.85
    else:  # normal
        depth_range = "50-61.8%"
        confidence = 0.8
    
    # Compute target price range
    diag_length = abs(req.diagonal_end_price - req.diagonal_start_price)
    
    if req.diagonal_end_price > req.diagonal_start_price:
        # Uptrend diagonal; correction is downward
        low_target = req.diagonal_end_price - diag_length * 0.618
        high_target = req.diagonal_end_price - diag_length * 0.5
    else:
        low_target = req.diagonal_end_price + diag_length * 0.5
        high_target = req.diagonal_end_price + diag_length * 0.618
    
    return CorrectionResponse(
        depth_pct_range=depth_range,
        target_price_range=f"{low_target:.2f} - {high_target:.2f}",
        confidence=confidence
    )
