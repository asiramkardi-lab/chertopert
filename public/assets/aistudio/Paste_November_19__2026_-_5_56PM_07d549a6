from app.schemas.zigzag import Wave, ZigzagResponse

def detect_structure(a: Wave, b: Wave, c: Wave) -> tuple[str, str]:
    """Detect zigzag structure type. Returns (structure, type)."""
    sa, sb, sc = a.sub_wave_count, b.sub_wave_count, c.sub_wave_count
    structure = f"{sa}-{sb}-{sc}"
    
    if (sa, sb, sc) == (5, 3, 5):
        return structure, "Ideal"
    elif (sa, sb, sc) == (3, 3, 3):
        return structure, "Simple"
    elif (sa, sb, sc) == (3, 5, 5):
        return structure, "Anti"
    else:
        return structure, "Invalid"
