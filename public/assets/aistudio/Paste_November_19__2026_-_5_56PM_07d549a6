### ۴.۲ کد کلیدی

**`schemas/rules.py`:**
```python
from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str  # "1", "2", "3", "4", "5", "A", "B", "C"
    start_idx: int
    end_idx: int
    start_price: float
    end_price: float
    direction: Literal["up", "down"]
    sub_waves: list["Wave"] = []
    is_impulsive: bool = False

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class RuleViolation(BaseModel):
    rule: Literal[1, 2, 3]
    severity: Literal["error", "warning"]
    description: str
    wave_label: str

class AlternativePattern(BaseModel):
    name: Literal["Terminal", "Anti-Terminal", "Diagonal", "Anti-Cycle", "Irregular Flat"]
    reason: str
    confidence: float = Field(ge=0, le=1)

class RelabelSuggestion(BaseModel):
    action: str  # e.g., "Reclassify wave 3 as extended"
    affected_waves: list[str]
    expected_fix: str

class ValidationRequest(BaseModel):
    waves: list[Wave]
    check_absolute_bottom: bool = True
    check_extension: bool = True

class ValidationResponse(BaseModel):
    valid: bool
    violations: list[RuleViolation] = []
    alternatives: list[AlternativePattern] = []
    is_mislabeling: bool = False
    relabeling_suggestions: list[RelabelSuggestion] = []
