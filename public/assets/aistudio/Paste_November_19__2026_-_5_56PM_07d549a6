from app.schemas.entry import Wave

def compute_retracement(wave_1: Wave, current_price: float) -> float:
    """Compute retracement percentage of wave 1 by current price."""
    if wave_1.length == 0:
        return 0.0
    
    if wave_1.end_price > wave_1.start_price:  # uptrend
        retracement = (wave_1.end_price - current_price) / wave_1.length
    else:  # downtrend
        retracement = (current_price - wave_1.end_price) / wave_1.length
    
    return max(0.0, min(2.0, retracement))  # clamp 0-200%

def validate_minimum_retracement(retracement: float) -> tuple[bool, str]:
    """Validate minimum 50% retracement."""
    if retracement < 0.5:
        return False, f"Retracement {retracement*100:.1f}% < 50% minimum"
    return True, f"Retracement {retracement*100:.1f}% >= 50%"
