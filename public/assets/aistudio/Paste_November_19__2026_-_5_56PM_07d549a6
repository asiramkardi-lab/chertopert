from app.schemas.triangle import TriangleRequest, TriangleResponse
from app.services.structure_service import detect_triangle_structure
from app.services.position_service import validate_position
from app.services.type_service import classify_triangle_type
from app.services.continuation_service import identify_continuation
from app.services.naming_service import validate_naming

def analyze_triangle(req: TriangleRequest) -> TriangleResponse:
    notes = []
    warnings = []
    
    # Step 1: Structure
    struct_ok, struct_msg = detect_triangle_structure(req.waves)
    if not struct_ok:
        return TriangleResponse(
            detected=False, confidence=0.0, notes=[struct_msg]
        )
    notes.append(struct_msg)
    
    # Step 2: Position
    pos_ok, pos_msg, freq = validate_position(req.position)
    if not pos_ok:
        return TriangleResponse(
            detected=True, position_valid=False,
            confidence=0.2,
            warnings=[pos_msg],
            notes=notes
        )
    notes.append(pos_msg)
    
    # Step 3: Type
    tri_type, type_msg = classify_triangle_type(req.waves)
    if tri_type == "Invalid":
        return TriangleResponse(
            detected=False, position_valid=pos_ok,
            confidence=0.0,
            warnings=[type_msg],
            notes=notes
        )
    notes.append(type_msg)
    
    # Step 4: Continuation
    continuation, cont_msg = identify_continuation(req.main_trend, req.breakout_direction)
    notes.append(cont_msg)
    
    # Step 5: Naming
    naming_ok, naming_msg = validate_naming(req.waves, "Triangle")
    if not naming_ok:
        warnings.append(naming_msg)
    notes.append(naming_msg)
    
    # Confidence
    confidence = 0.8 if naming_ok else 0.5
    if req.breakout_direction is None:
        confidence -= 0.2
        warnings.append("Await breakout confirmation")
    
    return TriangleResponse(
        detected=True,
        type=tri_type,
        position_valid=pos_ok,
        continuation=continuation,
        naming_valid=naming_ok,
        frequency=freq,
        confidence=confidence,
        warnings=warnings,
        notes=notes
    )
