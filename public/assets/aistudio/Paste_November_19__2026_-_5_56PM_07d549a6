from app.schemas.flat import Wave

def compute_c_pct(b: Wave, c: Wave) -> float:
    """Compute C as percentage of B."""
    if b.length == 0:
        return 0.0
    return c.length / b.length * 100

def classify_type(b_pct: float, c_pct: float) -> tuple[str, str]:
    """Classify Flat into 8 types."""
    # B-Deficient: B in 61.8-81%
    # B-Regular: B in 81-100%
    # B-Irregular: B > 100%
    
    # C-Deficient: C in 61.8-81%
    # C-Regular: C in 81-100%
    # C-Extended: C > 100%
    
    if b_pct > 138.2:
        if c_pct > 100:
            return "Irregular-Extended", f"B={b_pct:.1f}% (>138.2%), C={c_pct:.1f}% (>100%)"
        else:
            return "Irregular-Deficient", f"B={b_pct:.1f}% (>138.2%), C={c_pct:.1f}% (<100%)"
    elif b_pct > 100:
        if c_pct < 61.8:
            return "Running", f"B={b_pct:.1f}% (>100%), C={c_pct:.1f}% (<61.8%)"
        elif c_pct < 81:
            return "Irregular-Deficient", f"B={b_pct:.1f}% (>100%), C={c_pct:.1f}% (<81%)"
        else:
            return "Irregular", f"B={b_pct:.1f}% (>100%), C={c_pct:.1f}% (≥81%)"
    else:  # B in 61.8-100%
        if c_pct < 61.8:
            return "C-Deficient", f"B={b_pct:.1f}%, C={c_pct:.1f}% (<61.8%)"  # edge case
        elif c_pct < 81:
            if b_pct < 81:
                return "Double-Deficient", f"B={b_pct:.1f}% (<81%), C={c_pct:.1f}% (<81%)"
            else:
                return "C-Deficient", f"B={b_pct:.1f}%, C={c_pct:.1f}% (<81%)"
        else:  # C in 81-100%
            if b_pct < 81:
                return "B-Deficient", f"B={b_pct:.1f}% (<81%), C={c_pct:.1f}% (≥81%)"
            else:
                return "Regular", f"B={b_pct:.1f}% (81-100%), C={c_pct:.1f}% (81-100%)"
