from app.schemas.complex import ComplexRequest, Pattern

def detect_complex_pattern(req: ComplexRequest) -> tuple[str, bool]:
    """Detect complex pattern string and standard classification."""
    if len(req.components) < 2:
        return "Invalid", False
    
    parts = []
    for i, comp in enumerate(req.components):
        parts.append(comp.abbreviation)
        if i < len(req.components) - 1:
            parts.append("X")
    
    pattern_str = "-".join(parts)
    standard = len(req.components) == 2
    
    return pattern_str, standard
