from app.schemas.triangle import Wave

def classify_triangle_type(waves: list[Wave]) -> tuple[str, str]:
    """Classify Contracting vs Expanding based on highs/lows."""
    # Extract highs (peaks) and lows (troughs)
    # For uptrend: A, C, E are peaks; B, D are troughs
    # For downtrend: reversed
    
    if len(waves) != 5:
        return "Invalid", "Need 5 waves"
    
    a = waves[0]
    c = waves[2]
    e = waves[4]
    b = waves[1]
    d = waves[3]
    
    # Determine peak/trough based on wave direction
    # Simplified: use end_price as peak for up waves, low for down
    highs = [max(w.start_price, w.end_price) for w in [a, c, e]]
    lows = [min(w.start_price, w.end_price) for w in [b, d]]
    
    # Contracting: highs decreasing, lows increasing
    highs_decreasing = highs[0] > highs[1] > highs[2]
    lows_increasing = lows[0] < lows[1]
    
    # Expanding: highs increasing, lows decreasing
    highs_increasing = highs[0] < highs[1] < highs[2]
    lows_decreasing = lows[0] > lows[1]
    
    if highs_decreasing and lows_increasing:
        return "Contracting", "Highs decreasing, lows increasing (converging)"
    elif highs_increasing and lows_decreasing:
        return "Expanding", "Highs increasing, lows decreasing (diverging)"
    else:
        return "Invalid", "Trendlines not consistently converging or diverging"
