from app.schemas.diagonal import Wave, DiagonalRequest, DiagonalResponse
from app.services.structure_service import is_3_3_3_3_3, validate_diagonal_structure
from app.services.strength_service import compare_strengths

COMMON_LOCATIONS = {"1", "5", "C"}

def classify_diagonal(req: DiagonalRequest) -> DiagonalResponse:
    """Classify diagonal type based on structure and strength."""
    notes = []
    warnings = []
    
    # Validate structure
    is_valid, reason = validate_diagonal_structure(req.waves)
    if not is_valid:
        return DiagonalResponse(
            detected=False,
            location=req.wave_location,
            confidence=0.0,
            notes=[reason]
        )
    
    # Check location
    common = req.wave_location in COMMON_LOCATIONS
    if not common:
        warnings.append(f"Diagonal in wave {req.wave_location} is rare")
    
    # Compare strengths
    strengths = compare_strengths(req.waves)
    
    if strengths["pattern"] == "decreasing":
        diag_type = "Leading Ideal" if _has_ideal_1_2(req.waves) else "Impulsive"
        if req.wave_location == "5":
            diag_type = "Ending Diagonal"
    elif strengths["pattern"] == "increasing":
        diag_type = "Anti-Diagonal"
    else:
        return DiagonalResponse(
            detected=False,
            location=req.wave_location,
            confidence=0.0,
            notes=["Mixed wave strengths; not a valid diagonal"]
        )
    
    # Correction prediction
    if diag_type == "Ending Diagonal":
        correction_depth = "50-61.8% (to start of diagonal)"
        correction_target = "start_of_diagonal"
        confidence = 0.85
    elif diag_type == "Anti-Diagonal":
        correction_depth = ">61.8%"
        correction_target = "beyond_start"
        confidence = 0.75
    else:
        correction_depth = "50-61.8%"
        correction_target = "start_of_diagonal"
        confidence = 0.8
    
    notes.append(f"3-3-3-3-3 structure confirmed")
    notes.append(f"Wave strength pattern: {strengths['pattern']}")
    
    return DiagonalResponse(
        detected=True,
        type=diag_type,
        location=req.wave_location,
        common_location=common,
        warning="; ".join(warnings) if warnings else None,
        correction_depth=correction_depth,
        correction_target=correction_target,
        confidence=confidence,
        notes=notes
    )

def _has_ideal_1_2(waves: list[Wave]) -> bool:
    """Check if waves 1-2 have ideal 5-3 structure."""
    if len(waves) < 2:
        return False
    return waves[0].sub_wave_count == 5 and waves[1].sub_wave_count == 3
