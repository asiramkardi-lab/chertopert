from app.schemas.fibonacci import MotiveWave, GoldenRequest, GoldenResponse
from app.services.retracement_service import RETRACEMENT_LEVELS

def find_golden_level(req: GoldenRequest) -> GoldenResponse:
    """Find the nearest golden level for a given price."""
    wave = req.wave
    tolerance = req.tolerance_pct / 100.0
    
    best_match = None
    best_distance = float("inf")
    
    for pct in RETRACEMENT_LEVELS:
        ratio = pct / 100.0
        if wave.direction == "up":
            level_price = wave.end_price - wave.length * ratio
        else:
            level_price = wave.end_price + wave.length * ratio
        
        distance = abs(req.price - level_price) / wave.length if wave.length > 0 else 0
        
        if distance < best_distance:
            best_distance = distance
            best_match = (pct, level_price)
    
    if best_match and best_distance <= tolerance:
        return GoldenResponse(
            golden_level=best_match[0],
            distance_pct=round(best_distance * 100, 2),
            nearest_level=best_match[0],
            matched=True
        )
    
    return GoldenResponse(
        golden_level=None,
        distance_pct=round(best_distance * 100, 2) if best_match else 0.0,
        nearest_level=best_match[0] if best_match else None,
        matched=False
    )
