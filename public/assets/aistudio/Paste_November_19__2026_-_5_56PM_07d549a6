from fastapi import APIRouter, HTTPException
from app.schemas.non_ideal import (
    NonIdealRequest, NonIdealResponse,
    Wave5TerminalRequest, Wave5TerminalResponse
)
from app.services.terminal_service import detect_terminal
from app.services.anti_cycle_service import detect_anti_cycle
from app.services.wave5_terminal_service import detect_wave5_terminal

router = APIRouter(prefix="/api/v1/non-ideal", tags=["non-ideal"])

@router.post("/terminal", response_model=NonIdealResponse)
async def terminal_endpoint(req: NonIdealRequest):
    if len(req.waves) < 4:
        raise HTTPException(400, "Minimum 4 waves required")
    return detect_terminal(req.waves, req.tolerance_pct / 100)

@router.post("/anti-cycle", response_model=NonIdealResponse)
async def anti_cycle_endpoint(req: NonIdealRequest, position: str = "2"):
    if len(req.waves) < 2:
        raise HTTPException(400, "Minimum 2 waves required")
    return detect_anti_cycle(req.waves, position, req.is_market_end)

@router.post("/wave5-terminal", response_model=Wave5TerminalResponse)
async def wave5_terminal_endpoint(req: Wave5TerminalRequest):
    if not req.waves:
        raise HTTPException(400, "No waves provided")
    return detect_wave5_terminal(req.waves)
