from app.schemas.recognition import Wave, RecognitionResponse

def validate_degree_consistency(
    wave_2: Wave,
    wave_4: Wave
) -> RecognitionResponse:
    """Check if wave 2 and wave 4 have similar size/structure."""
    w2_len = len(wave_2.candles)
    w4_len = len(wave_4.candles)
    
    if w2_len == 0 or w4_len == 0:
        return RecognitionResponse(
            valid_wave=True, wave_count=1, degree="SIMPLE",
            consistency=False,
            warnings=["Cannot validate consistency (empty candles)"]
        )
    
    ratio = max(w2_len, w4_len) / min(w2_len, w4_len)
    
    if ratio > 10:
        return RecognitionResponse(
            valid_wave=True, wave_count=1, degree="SIMPLE",
            consistency=False,
            warnings=[f"Degree mismatch: wave 2 = {w2_len} candles, wave 4 = {w4_len} candles (ratio {ratio:.1f}x)"]
        )
    
    return RecognitionResponse(
        valid_wave=True, wave_count=1, degree="SIMPLE",
        consistency=True,
        warnings=[]
    )

MAX_DEGREES = {
    "daily": 4,
    "weekly": 3,
    "monthly": 2,
    "4h": 5,
    "1h": 6,
}

DEGREE_LABELS = ["V", "W", "BOLD", "SIMPLE"]

def assign_degrees(nesting_depth: int, timeframe: str) -> list[str]:
    max_deg = MAX_DEGREES.get(timeframe, 4)
    if nesting_depth <= max_deg:
        return DEGREE_LABELS[:nesting_depth]
    return DEGREE_LABELS[:max_deg]
