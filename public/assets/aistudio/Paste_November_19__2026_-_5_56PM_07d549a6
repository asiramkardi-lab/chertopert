from app.schemas.rules import Wave

def detect_extension(waves: list[Wave]) -> str | None:
    """Detect which wave (1, 3, or 5) is extended (>161.8% of others)."""
    wave_map = {w.label: w for w in waves}
    
    if not all(label in wave_map for label in ["1", "3", "5"]):
        return None
    
    lengths = {label: wave_map[label].length for label in ["1", "3", "5"]}
    threshold = 1.618
    
    for label in ["1", "3", "5"]:
        others = [lengths[l] for l in ["1", "3", "5"] if l != label]
        if all(lengths[label] > threshold * other for other in others):
            return f"wave_{label}"
    
    return None
