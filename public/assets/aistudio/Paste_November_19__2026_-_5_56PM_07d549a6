def compare_strengths(waves: list[Wave]) -> dict:
    """Compare wave 1, 3, 5 strengths to detect diagonal type."""
    if len(waves) < 5:
        return {"pattern": "insufficient"}
    
    # Use length as proxy for strength (could be enhanced with volume)
