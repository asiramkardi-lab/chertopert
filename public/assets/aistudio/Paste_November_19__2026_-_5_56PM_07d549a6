export const useFlatTypesEngine = () => {
  const result = ref<FlatTypeResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (req: FlatTypeRequest) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<FlatTypeResponse>('/api/v1/flat-types/analyze', {
        method: 'POST', body: req
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
