from app.services.prz_service import identify_prz
from app.services.trailing_service import recommend_trailing_stop
from app.services.validation_service import validate_no_retracement_on_wave_5

def analyze_extension(req: ExtensionRequest) -> ExtensionResponse:
    notes = []
    warnings = []
    
    if req.wave_1.length == 0:
        return ExtensionResponse(
            valid=False, confidence=0.0,
            warnings=["Wave 1 has zero length"]
        )
    
    # Step 1: Extension
    extension, severity, ext_warnings = detect_extension(req)
    warnings.extend(ext_warnings)
    if extension:
        notes.append(f"Extension: {extension} ({severity})")
    
    # Step 2: TMV
    tmv = compute_tmv(req)
    notes.append(f"TMV: Prime={tmv.prime}, Ideal={tmv.ideal}, Alternate={tmv.alternate}")
    
    # Step 3: PRZ
    prz = identify_prz(req, "wave_2")
    if prz:
        notes.append(f"PRZ: {prz.level*100}% ({prz.context})")
    
    # Step 4: Trailing stop
    trailing = None
    if req.current_price is not None:
        trailing = recommend_trailing_stop(req.current_price, tmv, extension)
        notes.append(f"Trailing: {trailing}")
    
    # Confidence
    confidence = 0.8
    if extension == "wave_5":
        confidence = 0.9
        warnings.append("Wave 5 extension: high reversal risk")
    elif extension == "wave_3":
        confidence = 0.85
    elif extension is None:
        confidence = 0.7
    
    return ExtensionResponse(
        extension=extension,
        extension_severity=severity,
        tmv=tmv,
        prz=prz,
        trailing_stop=trailing,
        valid=True,
        confidence=confidence,
        warnings=warnings,
        notes=notes
    )
