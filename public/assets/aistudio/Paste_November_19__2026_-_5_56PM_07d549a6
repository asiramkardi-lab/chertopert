from app.schemas.triangle import Wave, TriangleResponse

def detect_triangle_structure(waves: list[Wave]) -> tuple[bool, str]:
    """Validate 5 waves A-E, each with 3 sub-waves."""
    if len(waves) != 5:
        return False, f"Expected 5 waves (A-E), got {len(waves)}"
    
    labels = [w.label for w in waves]
    if labels != ["A", "B", "C", "D", "E"]:
        return False, f"Labels must be A-B-C-D-E, got {labels}"
    
    for i, w in enumerate(waves):
        if w.sub_wave_count != 3:
            return False, f"Wave {w.label} has {w.sub_wave_count} sub-waves, expected 3"
    
    return True, "Valid Triangle: A-B-C-D-E with 3-3-3-3-3 structure"
