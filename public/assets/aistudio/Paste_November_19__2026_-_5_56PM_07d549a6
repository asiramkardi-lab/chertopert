import numpy as np
from typing import Optional
from app.schemas.wave import WaveCount, WavePoint

def count_waves(prices: list[float], highs: list[float], lows: list[float]) -> list[WaveCount]:
    """
    Main entry point. Returns list of candidate wave counts.
    """
    # 1. Find pivots (local extrema)
    pivots = find_pivots(highs, lows, window=5)
    
    # 2. Build candidate sequences
    candidates = build_candidates(pivots, prices)
    
    # 3. Validate cardinal rules
    valid = []
    for seq in candidates:
        violations = validate_rules(seq, prices)
        if not any(v['severity'] == 'error' for v in violations):
            valid.append(seq)
    
    # 4. Classify patterns
    results = []
    for seq in valid:
        pattern = classify_pattern(seq, prices)
        confidence = calculate_confidence(seq, pattern, prices)
        results.append(WaveCount(
            id=hash_sequence(seq),
            labels=seq.labels,
            points=[WavePoint(label=l, index=i, price=prices[i]) 
                    for l, i in zip(seq.labels, seq.points)],
            confidence=confidence,
            violations=violations,
            alternative=suggest_alternative(seq, pattern)
        ))
    
    # 5. Sort by confidence, return top N
    return sorted(results, key=lambda x: x.confidence, reverse=True)[:5]

def find_pivots(highs: list[float], lows: list[float], window: int = 5) -> list[dict]:
    """Find local extrema using a rolling window."""
    pivots = []
    for i in range(window, len(highs) - window):
        if highs[i] == max(highs[i-window:i+window+1]):
            pivots.append({'index': i, 'type': 'high', 'price': highs[i]})
        if lows[i] == min(lows[i-window:i+window+1]):
            pivots.append({'index': i, 'type': 'low', 'price': lows[i]})
    return pivots

def validate_rules(seq, prices) -> list[dict]:
    """Validate three cardinal rules."""
    violations = []
    waves = seq.waves
    
    # Rule 1: Wave 2 must not retrace 100% of Wave 1
    if len(waves) >= 2:
        w1 = waves[0]
        w2 = waves[1]
        if w2.end_price <= w1.start_price if w1.direction == 'up' else w2.end_price >= w1.start_price:
            violations.append({'rule': 1, 'severity': 'error', 
                             'description': 'Wave 2 retraced 100%+ of Wave 1'})
    
    # Rule 2: Wave 3 must not be shortest
    if len(waves) >= 3:
        lengths = [abs(w.end_price - w.start_price) for w in waves[:3]]
        if lengths[2] == min(lengths):
            violations.append({'rule': 2, 'severity': 'error',
                             'description': 'Wave 3 is the shortest'})
    
    # Rule 3: Wave 4 must not overlap Wave 1
    if len(waves) >= 4:
        w1 = waves[0]
        w4 = waves[3]
        if w1.direction == 'up' and w4.end_price <= w1.end_price:
            violations.append({'rule': 3, 'severity': 'warning',
                             'description': 'Wave 4 overlaps Wave 1 (possible Terminal/Diagonal)'})
        elif w1.direction == 'down' and w4.end_price >= w1.end_price:
            violations.append({'rule': 3, 'severity': 'warning',
                             'description': 'Wave 4 overlaps Wave 1 (possible Terminal/Diagonal)'})
    
    return violations
api/v1/waves.py:

python
from fastapi import APIRouter, HTTPException
from app.schemas.wave import CountRequest, CountResponse
from app.services.wave_engine import count_waves

router = APIRouter(prefix="/api/v1/waves", tags=["waves"])

@router.post("/count", response_model=CountResponse)
async def count_waves_endpoint(req: CountRequest):
    if len(req.data) < 10:
        raise HTTPException(400, "Insufficient data (minimum 10 candles)")
    
    prices = [d.close for d in req.data]
    highs = [d.high for d in req.data]
    lows = [d.low for d in req.data]
    
    counts = count_waves(prices, highs, lows)
    filtered = [c for c in counts if c.confidence >= req.min_confidence]
    
    return CountResponse(counts=filtered)
