PRIORITY = {
    "I": 1, "G": 2, "T": 3, "F": 5, "Z": 4, "Tri": 6, "Complex": 7
}

def apply_priority(req: ComplexRequest) -> tuple[str, int]:
    """Apply priority order."""
    if req.simple_possible and req.simple_pattern:
        simple = req.simple_pattern.abbreviation
        return simple, PRIORITY.get(simple, 7)
    
    # If no simple, complex is last resort
    return "Complex", 7
