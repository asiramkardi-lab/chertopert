from fastapi import APIRouter, HTTPException
from app.schemas.entry import EntryRequest, EntryResponse
from app.services.retracement_service import compute_retracement, validate_minimum_retracement
from app.services.prime_zones_service import identify_prime_zone
from app.services.fallback_service import detect_fallback
from app.services.scenario_service import score_scenario
from app.services.multi_step_service import recommend_steps

router = APIRouter(prefix="/api/v1/entry", tags=["entry"])

@router.post("/analyze", response_model=EntryResponse)
async def analyze_endpoint(req: EntryRequest):
    if req.wave_1.length == 0:
        raise HTTPException(400, "Wave 1 has zero length")
    
    retracement = compute_retracement(req.wave_1, req.current_price)
    valid_min, min_msg = validate_minimum_retracement(retracement)
    
    if not valid_min:
        return EntryResponse(
            scenario="uncertain", confidence=0.5, risk="high",
            retracement_pct=round(retracement * 100, 2),
            notes=[min_msg],
            warnings=["Entry not recommended: < 50% retracement"]
        )
    
    # Prime zone
    prime_zone = identify_prime_zone(req.wave_1, req.current_price)
    
    # Fallback
    fallback, fb_msg = detect_fallback(
        req.wave_1, req.current_price, req.wave_2.end_price
    )
    
    # Scenario
    scenario, confidence = score_scenario(req, retracement)
    
    # Steps
    steps = recommend_steps(scenario, req.wave_1)
    
    # Entry zone
    if req.wave_2_complete and req.current_price > req.wave_1.end_price:
        entry_zone = "start_wave_3"
        risk = "low"
    elif prime_zone:
        entry_zone = prime_zone[0].split()[0]
        risk = "medium" if req.signal_present else "high"
    elif fallback:
        entry_zone = "50%_pullback"
        risk = "medium"
    else:
        entry_zone = "none"
        risk = "high"
    
    notes = [min_msg]
    if prime_zone:
        notes.append(f"Prime zone: {prime_zone[0]}")
    if fallback:
        notes.append(fb_msg)
    
    return EntryResponse(
        entry_zone=entry_zone,
        scenario=scenario,
        confidence=confidence,
        risk=risk,
        steps=steps,
        fallback=fallback,
        retracement_pct=round(retracement * 100, 2),
        notes=notes
    )
