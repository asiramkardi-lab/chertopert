from app.schemas.non_ideal import Wave, PRZ, TMV

def compute_prz(wave: Wave, fib_level: float = 0.618) -> PRZ:
    """Compute Potential Reversal Zone for a corrective wave."""
    if wave.direction == "up":
        # Corrective wave retraces upward
        start = wave.start_price
        end = wave.start_price + wave.length * fib_level
    else:
        start = wave.start_price
        end = wave.start_price - wave.length * fib_level
    
    return PRZ(
        start_price=min(start, end),
        end_price=max(start, end),
        fib_level=fib_level,
        source="retracement"
    )

def compute_tmv(wave1: Wave, wave2: Wave, fib_level: float = 1.0) -> TMV:
    """Compute Target Movement Value for wave 3 (projection from wave 1-2)."""
    # Projection: wave 1 length projected from wave 2 end
    if wave2.direction == "up":
        start = wave2.end_price
        end = wave2.end_price + wave1.length * fib_level
    else:
        start = wave2.end_price
        end = wave2.end_price - wave1.length * fib_level
    
    return TMV(
        start_price=min(start, end),
        end_price=max(start, end),
        fib_level=fib_level,
        source="projection"
    )

def check_wave5_reaches_tmv(wave5: Wave, tmv: TMV, tolerance: float = 0.01) -> bool:
    """Check if wave 5 reaches its TMV."""
    if wave5.direction == "up":
        return wave5.end_price >= tmv.start_price * (1 - tolerance)
    else:
        return wave5.end_price <= tmv.end_price * (1 + tolerance)
