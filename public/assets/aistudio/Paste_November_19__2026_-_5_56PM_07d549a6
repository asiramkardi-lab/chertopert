from app.schemas.zigzag import Wave

def predict_post_pattern(
    wave_a: Wave, wave_b: Wave, wave_c: Wave,
    wave_c_class: str
) -> tuple[float, str]:
    """Predict post-pattern move (first jump target)."""
    b_pct_of_a = wave_b.length / wave_a.length if wave_a.length > 0 else 0
    b_large = b_pct_of_a > 0.618
    
    if wave_c_class == "Normal":
        if b_large:
            return 0.618, "61.8% of whole pattern"
        else:
            return 0.382, "38.2% of whole pattern"
    elif wave_c_class == "Truncated":
        if b_large:
            return 0.81, "81% of wave C (or 61.8% of whole pattern)"
        else:
            return 0.382, "38.2% of whole pattern"
    elif wave_c_class == "Extended":
        if b_large:
            return 0.382, "38.2% of whole pattern"
        else:
            return 0.236, "23.6% of whole pattern"
    
    return 0.0, "Unknown"
