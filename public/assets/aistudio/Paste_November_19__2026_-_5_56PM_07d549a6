def compute_confidence(
    is_market_end: bool,
    has_confirmation: bool,
    base_confidence: float = 0.85
) -> tuple[float, list[str]]:
    """Adjust confidence based on market-end context."""
    warnings = []
    
    if is_market_end:
        if has_confirmation:
            return 0.7, ["At market end: more alternative patterns possible; confirmation applied"]
        else:
            warnings.append("At market end without confirmation; lower reliability")
            return 0.5, warnings
    
    return base_confidence, []
