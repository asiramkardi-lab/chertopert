from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str
    start_price: float
    end_price: float
    sub_wave_count: int = 3

class Pattern(BaseModel):
    abbreviation: Literal["I", "G", "T", "F", "Z", "Tri"]  # Ideal, Diagonal, Terminal, Flat, Zigzag, Triangle
    waves: list[Wave] = []

class ComplexRequest(BaseModel):
    components: list[Pattern]  # 2+ patterns
    x_wave: Pattern
    is_market_end: bool = False
    simple_possible: bool = False
    simple_pattern: Optional[Pattern] = None

class ComplexResponse(BaseModel):
    pattern: str  # e.g., "Z-X-Z", "F-X-T"
    valid: bool
    violated_rules: list[int] = []
    priority_rank: int = 7
    recommend: Literal["simple", "complex", "recount"] = "complex"
    standard: bool = True
    confidence: float = Field(ge=0, le=1)
    warnings: list[str] = []
    notes: list[str] = []
