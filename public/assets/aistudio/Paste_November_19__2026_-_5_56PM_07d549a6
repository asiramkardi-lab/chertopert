def compute_confidence(
    is_market_end: bool,
    has_confirmation: bool,
    flat_type: str
) -> tuple[float, list[str]]:
    """Adjust confidence based on context."""
    warnings = []
    base = 0.8
    
    # Flat type adjustment
    if flat_type == "Double-Deficient":
        base -= 0.15
        warnings.append("Double-Deficient Flat is high-risk")
    elif flat_type == "Running":
        base -= 0.1
        warnings.append("Running Flat is rare and risky")
    elif flat_type == "Irregular-Extended":
        base -= 0.05
    
    # Market-end adjustment
    if is_market_end:
        if has_confirmation:
            base -= 0.2
        else:
            base -= 0.4
            warnings.append("Flat at market end without confirmation; low confidence")
    
    return max(0.0, min(1.0, base)), warnings
