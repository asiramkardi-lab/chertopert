def analyze_all_waves(req: CharacteristicsRequest) -> CharacteristicsResponse:
    warnings = []
    notes = []
    
    wmap = {w.label: w for w in req.waves}
    required = ["1", "2", "3", "4", "5", "A", "B", "C"]
    missing = [r for r in required if r not in wmap]
    
    if missing:
        return CharacteristicsResponse(
            features=[], overall_confidence=0.0,
            warnings=[f"Missing waves: {missing}"]
        )
    
    features = []
    w1, w2, w3, w4, w5 = wmap["1"], wmap["2"], wmap["3"], wmap["4"], wmap["5"]
    wa, wb, wc = wmap["A"], wmap["B"], wmap["C"]
    
    features.append(analyze_wave_1(w1, w3, w5))
    features.append(analyze_wave_2(w1, w2))
    features.append(analyze_wave_3(w1, w3, w5))
    features.append(analyze_wave_4(w3, w4))
    features.append(analyze_wave_5(w3, w5))
    features.append(analyze_wave_a(w5, wa))
    features.append(analyze_wave_b(wa, wb))
    features.append(analyze_wave_c(w5, wc))
    
    invalid = [f.label for f in features if not f.characteristics_valid]
    if invalid:
        warnings.append(f"Invalid characteristics: {invalid}")
    
    confidence = 0.8 if not invalid else 0.5
    notes.append(f"Analyzed {len(features)} waves")
    
    return CharacteristicsResponse(
        features=features,
        overall_confidence=confidence,
        warnings=warnings,
        notes=notes
    )
