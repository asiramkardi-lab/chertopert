from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str
    start_price: float
    end_price: float
    sub_wave_count: int = 3
    is_sub_triangle: bool = False

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class TriangleRequest(BaseModel):
    waves: list[Wave]  # 5 waves A-E
    main_trend: Literal["up", "down"] = "up"
    breakout_direction: Optional[Literal["up", "down"]] = None
    pullback_present: bool = False
    wave_position: Literal["2", "4", "B", "5"] = "4"

class TriangleResponse(BaseModel):
    type: Optional[Literal["Contracting", "Expanding", "Ascending", "Descending", "Limited", "Unlimited"]] = None
    secondary_types: list[str] = []
    ideal_retracement: bool = False
    ideal_completion: bool = False
