export const useProjectionEngine = () => {
  const projection = ref<ProjectionResponse | null>(null)
  const tmv = ref<TMVResponse | null>(null)
  const overlap = ref<OverlapResponse | null>(null)
  const validation = ref<RetracementValidationResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const computeProjection = async (points: ThreePoint, targetWave: '3'|'5', pair: '1-2'|'3-4') => {
    loading.value = true
    error.value = null
    try {
      projection.value = await $fetch<ProjectionResponse>('/api/v1/projection/compute', {
        method: 'POST',
        body: { points, target_wave: targetWave, previous_pair: pair }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Projection failed'
    } finally {
      loading.value = false
    }
  }

  const computeTMV = async (points: ThreePoint, previousExtreme: number) => {
    try {
      tmv.value = await $fetch<TMVResponse>('/api/v1/projection/tmv', {
        method: 'POST',
        body: { points, previous_wave_extreme: previousExtreme }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'TMV computation failed'
    }
  }

  const checkOverlap = async (tmvPrice: number, przStart: number, przEnd: number) => {
    try {
      overlap.value = await $fetch<OverlapResponse>('/api/v1/projection/overlap', {
        method: 'POST',
        body: { tmv: tmvPrice, prz_start: przStart, prz_end: przEnd }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Overlap check failed'
    }
  }

  const validateRetracement = async (waveLabel: string, retracementPct: number) => {
    try {
      validation.value = await $fetch<RetracementValidationResponse>('/api/v1/projection/validate-retracement', {
        method: 'POST',
        body: { wave_label: waveLabel, retracement_pct: retracementPct }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Validation failed'
    }
  }

  return { projection, tmv, overlap, validation, loading, error, computeProjection, computeTMV, checkOverlap, validateRetracement }
}
