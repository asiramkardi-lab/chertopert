typescript
export const useWaveEngine = () => {
  const counts = ref<WaveCount[]>([])
  const loading = ref(false)
  const error = ref<string | null>(null)

  const count = async (data: OHLCV[], minConfidence = 0.3) => {
    loading.value = true
    error.value = null
    try {
      const res = await $fetch<CountResponse>('/api/v1/waves/count', {
        method: 'POST',
        body: { data, min_confidence: minConfidence }
      })
      counts.value = res.counts
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { counts, loading, error, count }
}
