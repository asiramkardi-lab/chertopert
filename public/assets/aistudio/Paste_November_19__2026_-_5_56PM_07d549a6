from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str
    start_idx: int
    end_idx: int
    start_price: float
    end_price: float
    direction: Literal["up", "down"]
    sub_waves: list["Wave"] = []

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class PRZ(BaseModel):
    start_price: float
    end_price: float
    fib_level: float
    source: Literal["retracement", "support_resistance", "channel"]

class TMV(BaseModel):
    start_price: float
    end_price: float
    fib_level: float
    source: Literal["projection", "extension"]

class NonIdealRequest(BaseModel):
    waves: list[Wave]
    is_market_end: bool = False
    tolerance_pct: float = Field(default=1.0, ge=0, le=10)

class NonIdealResponse(BaseModel):
    pattern: Optional[Literal["Terminal", "Anti-Terminal", "Anti-Cycle", "Diagonal"]] = None
    valid: bool
    violations: list[dict] = []
    prz: Optional[PRZ] = None
    tmv: Optional[TMV] = None
    wave_5_reaches_tmv: bool = False
    wave_5_coverage_of_wave_4: float = 0.0
    wave_a_retracement: Optional[float] = None
    notes: list[str] = []

class Wave5TerminalRequest(BaseModel):
    waves: list[Wave]

class Wave5TerminalResponse(BaseModel):
    wave_5_terminal: bool
    predict_wave_a_100pct: bool
    confidence: float = Field(ge=0, le=1)
