    </template>
    <div class="relative h-64 bg-muted/20 rounded-lg">
      <svg viewBox="0 0 400 250" class="w-full h-full">
        <!-- Trendlines -->
        <line x1="50" y1="50" x2="350" y2="120" stroke="currentColor" stroke-width="2" class="text-primary" />
        <line x1="50" y1="200" x2="350" y2="130" stroke="currentColor" stroke-width="2" class="text-primary" />
        <!-- Waves -->
        <polyline
          v-if="waves.length"
          :points="wavePath"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          class="text-warning"
        />
        <!-- Labels -->
        <text v-for="(w, i) in waves" :key="i" :x="labelPositions[i].x" :y="labelPositions[i].y" class="fill-foreground text-sm font-bold">
          {{ w.label }}
        </text>
      </svg>
    </div>
  </UCard>
