from app.schemas.complex import ComplexRequest, ComplexResponse
from app.services.detect_service import detect_complex_pattern
from app.services.validate_service import validate_cardinal_rules
from app.services.priority_service import apply_priority
from app.services.x_wave_service import validate_x_wave
from app.services.recommend_service import recommend_simple_vs_complex

def analyze_complex(req: ComplexRequest) -> ComplexResponse:
    notes = []
    warnings = []
    
    # Step 1: Detect
    pattern, standard = detect_complex_pattern(req)
    if pattern == "Invalid":
        return ComplexResponse(
            pattern="Invalid", valid=False, confidence=0.0,
            notes=["Need 2+ components"]
        )
    notes.append(f"Pattern: {pattern}")
    
    # Step 2: Validate
    rules_ok, violations = validate_cardinal_rules(req)
    if not rules_ok:
        return ComplexResponse(
            pattern=pattern, valid=False, violated_rules=violations,
            confidence=0.0,
            warnings=[f"Violated rules: {violations}"]
        )
    notes.append("3 cardinal rules satisfied")
    
    # Step 3: Priority
    chosen, rank = apply_priority(req)
    notes.append(f"Priority: {chosen} (rank {rank})")
    
    # Step 4: X-Wave
    x_ok, x_msg = validate_x_wave(req.x_wave)
    if not x_ok:
        return ComplexResponse(
            pattern=pattern, valid=False, confidence=0.0,
            warnings=[x_msg]
        )
    notes.append(x_msg)
    
    # Step 5: Recommend
    recommend, rec_msg = recommend_simple_vs_complex(req)
    notes.append(rec_msg)
    
    # Confidence
    confidence = 0.5
    if recommend == "simple":
        confidence = 0.8
        warnings.append("Simple pattern preferred; complex is secondary")
    elif recommend == "recount":
        confidence = 0.3
        warnings.append("Recount recommended")
    else:
        confidence = 0.5
    
    if not standard:
        confidence -= 0.1
        warnings.append("Non-standard complex (3+ patterns)")
    
    return ComplexResponse(
        pattern=pattern,
        valid=True,
        violated_rules=violations,
        priority_rank=rank,
        recommend=recommend,
        standard=standard,
        confidence=max(0.0, min(1.0, confidence)),
        warnings=warnings,
        notes=notes
    )
