from app.schemas.triangle_advanced import Wave

def classify_six_types(waves: list[Wave]) -> tuple[str, list[str], str]:
    """Classify into 6 types (can overlap)."""
    if len(waves) != 5:
        return "Invalid", [], "Need 5 waves"
    
    a, b, c, d, e = waves
    
    # Primary classification: Contracting vs Expanding
    highs = [max(w.start_price, w.end_price) for w in [a, c, e]]
    lows = [min(w.start_price, w.end_price) for w in [b, d]]
    
    contracting = highs[0] > highs[1] > highs[2] and lows[0] < lows[1]
    expanding = highs[0] < highs[1] < highs[2] and lows[0] > lows[1]
    
    if contracting:
        primary = "Contracting"
    elif expanding:
        primary = "Expanding"
    else:
        return "Invalid", [], "Trendlines inconsistent"
    
    # Secondary: Ascending / Descending
    secondary = []
    top_flat = abs(highs[0] - highs[2]) / highs[0] < 0.05
    bottom_flat = abs(lows[0] - lows[1]) / lows[0] < 0.05
    
    if top_flat and not bottom_flat:
        secondary.append("Ascending")
    elif bottom_flat and not top_flat:
        secondary.append("Descending")
    
    # Limited vs Unlimited
    if a.is_sub_triangle:
        secondary.append("Unlimited")
    else:
        secondary.append("Limited")
    
    return primary, secondary, f"Primary: {primary}, Secondary: {secondary}"
