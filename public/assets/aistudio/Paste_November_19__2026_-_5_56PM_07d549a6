from app.services.bottom_service import detect_absolute_bottom

def step_count(req: StepRequest) -> StepResponse:
    """
    Step-by-step wave counting from high to low timeframe.
    """
    steps = []
    notes = []
    
    # Step 1: Find absolute bottom
    bottom = detect_absolute_bottom(req.candles)
    if not bottom.formed:
        return StepResponse(
            steps=[], final_count=[], 
            stopped_at_degree="NONE",
            notes=["Cannot count: no absolute bottom"]
        )
    
    notes.append(bottom.reason)
    
    # Step 2: Assign degrees based on nesting depth
    from app.services.degree_service import assign_degrees
    degrees = assign_degrees(req.max_degree, req.timeframe)
    
    # Step 3: Simulate step-by-step counting (simplified)
    for i, degree in enumerate(degrees):
        step = StepResult(
            degree=degree,
            start_idx=bottom.absolute_bottom_idx or 0,
            end_idx=len(req.candles) - 1,
            waves=[]  # Would be populated by actual wave counting
        )
        steps.append(step)
    
    notes.append(f"Counted {len(degrees)} degrees: {degrees}")
    notes.append(f"Stopped at degree: {degrees[-1] if degrees else 'NONE'}")
    
    return StepResponse(
        steps=steps,
        final_count=[],
        stopped_at_degree=degrees[-1] if degrees else "NONE",
        notes=notes
    )
