from app.schemas.fibonacci import MotiveWave, FibLevel, FibResponse

RETRACEMENT_LEVELS = [23.6, 38.2, 50.0, 61.8, 78.6]

SR_IMPORTANCE = {
    23.6: "none",
    38.2: "moderate",
    50.0: "very_weak",
    61.8: "very_strong",
    78.6: "strong",
}

ID_IMPORTANCE = {
    23.6: True,
    38.2: True,
    50.0: False,
    61.8: True,
    78.6: True,
}

ACCELERATION = {
    78.6: True,
}

def compute_retracement(wave: MotiveWave) -> FibResponse:
    """Compute retracement levels (X→Y orientation)."""
    levels = []
    
    for pct in RETRACEMENT_LEVELS:
        ratio = pct / 100.0
        if wave.direction == "up":
            price = wave.end_price - wave.length * ratio
        else:
            price = wave.end_price + wave.length * ratio
        
        levels.append(FibLevel(
            level=pct,
            price=round(price, 4),
            sr_importance=SR_IMPORTANCE[pct],
            id_importance=ID_IMPORTANCE[pct],
            acceleration=ACCELERATION.get(pct, False)
        ))
    
    return FibResponse(
        levels=levels,
        draw_from=wave.start_price,
        draw_to=wave.end_price,
        orientation="X→Y",
        mode="retracement"
    )
