export const useEntryEngine = () => {
  const result = ref<EntryResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (req: EntryRequest) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<EntryResponse>('/api/v1/entry/analyze', {
        method: 'POST', body: req
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
