from app.schemas.entry import EntryRequest

def score_scenario(req: EntryRequest, retracement: float) -> tuple[str, float]:
    """Score W2 vs A scenario based on structure, retracement, support."""
    score_w2 = 0.0
    score_a = 0.0
    
    # Structure
    if req.structure == "5-3-5":
        score_w2 += 0.4
    elif req.structure == "3-3-3":
        score_a += 0.4
    elif req.structure == "3-5-5":
        score_w2 += 0.2
    
    # Retracement
    if retracement >= 0.618:
        score_w2 += 0.35
    elif retracement >= 0.5:
        score_w2 += 0.15
        score_a += 0.15
    elif retracement <= 0.382:
        score_a += 0.35
    
    # Support
    if req.has_support:
        score_w2 += 0.2
    
    # Total
    total = score_w2 + score_a
    if total == 0:
        return "uncertain", 0.5
    
    if score_w2 > score_a * 1.5:
        return "W2", min(0.95, score_w2 / total + 0.1)
    elif score_a > score_w2 * 1.5:
        return "A", min(0.95, score_a / total + 0.1)
    else:
        return "uncertain", 0.5
