from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str  # "A", "B", "C"
    start_price: float
    end_price: float
    sub_wave_count: int  # 3 or 5

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class ZigzagRequest(BaseModel):
    wave_a: Wave
    wave_b: Wave
    wave_c: Wave
    is_market_end: bool = False
    has_confirmation: bool = False

class ZigzagResponse(BaseModel):
    detected: bool
    type: Optional[Literal["Ideal", "Simple", "Anti"]] = None
    structure: str  # e.g., "5-3-5"
    wave_c_class: Optional[Literal["Truncated", "Normal", "Extended"]] = None
    post_pattern_target: Optional[float] = None
    post_pattern_basis: Optional[str] = None
    ab_cd: bool = False
    ab_cd_tolerance: float = 0.0
    confidence: float = Field(ge=0, le=1)
    warnings: list[str] = []
    notes: list[str] = []
