export const useRulesEngine = () => {
  const validation = ref<ValidationResponse | null>(null)
  const absoluteBottom = ref<AbsoluteBottomResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const validate = async (waves: Wave[]) => {
    loading.value = true
    error.value = null
    try {
      validation.value = await $fetch<ValidationResponse>(
        '/api/v1/rules/validate',
        { method: 'POST', body: { waves, check_absolute_bottom: true, check_extension: true } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Validation failed'
    } finally {
      loading.value = false
    }
  }

  const checkAbsoluteBottom = async (waves: Wave[]) => {
    try {
      absoluteBottom.value = await $fetch<AbsoluteBottomResponse>(
        '/api/v1/rules/absolute-bottom',
        { method: 'POST', body: { waves } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Absolute bottom check failed'
    }
  }

  return { validation, absoluteBottom, loading, error, validate, checkAbsoluteBottom }
}
