from app.schemas.fractal import (
    Wave, FractalValidationRequest, FractalValidationResponse, FractalViolation
)

MOTIVE_LABELS = {"1", "3", "5", "A", "C", "V1", "V3", "V5", "W1", "W3", "W5"}
CORRECTIVE_LABELS = {"2", "4", "B", "V2", "V4", "VB", "W2", "W4", "WB"}

def validate_fractal(req: FractalValidationRequest) -> FractalValidationResponse:
    violations = []
    assumed = {}

    for wave in req.waves:
        if wave.label in MOTIVE_LABELS:
            expected = 5
            actual = len(wave.sub_waves)
            if wave.is_impulsive:
                assumed[wave.label] = 5
                continue
            if actual != 5:
                violations.append(FractalViolation(
                    wave_label=wave.label,
                    expected_structure=5,
                    actual_structure=actual,
                    is_impulsive=False,
                    reason=f"Motive wave {wave.label} has {actual} sub-waves, expected 5"
                ))
        elif wave.label in CORRECTIVE_LABELS:
            expected = 3
            actual = len(wave.sub_waves)
            if wave.is_impulsive:
                assumed[wave.label] = 3
                continue
            if actual != 3:
                # If 5 sub-waves, it might be an anti-cycle or complex pattern
                violations.append(FractalViolation(
                    wave_label=wave.label,
                    expected_structure=3,
                    actual_structure=actual,
                    is_impulsive=False,
                    reason=f"Corrective wave {wave.label} has {actual} sub-waves, expected 3 (possible anti-cycle)"
                ))

    return FractalValidationResponse(
        valid=len(violations) == 0,
        violations=violations,
        assumed_structures=assumed
    )
