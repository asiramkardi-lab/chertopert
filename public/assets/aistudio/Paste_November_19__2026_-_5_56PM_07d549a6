export const useFibonacciEngine = () => {
  const retracement = ref<FibResponse | null>(null)
  const extension = ref<FibResponse | null>(null)
  const golden = ref<GoldenResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const compute = async (wave: MotiveWave, mode: 'retracement' | 'extension') => {
    loading.value = true
    error.value = null
    try {
      const result = await $fetch<FibResponse>('/api/v1/fibonacci/levels', {
        method: 'POST',
        body: { wave, mode }
      })
      if (mode === 'retracement') retracement.value = result
      else extension.value = result
    } catch (e: any) {
      error.value = e.data?.detail || 'Computation failed'
    } finally {
      loading.value = false
    }
  }

  const findGolden = async (price: number, wave: MotiveWave, tolerance = 1.0) => {
    try {
      golden.value = await $fetch<GoldenResponse>('/api/v1/fibonacci/golden', {
        method: 'POST',
        body: { price, wave, tolerance_pct: tolerance }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Golden level search failed'
    }
  }

  return { retracement, extension, golden, loading, error, compute, findGolden }
}
