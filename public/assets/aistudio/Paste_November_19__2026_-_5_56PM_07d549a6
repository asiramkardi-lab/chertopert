            valid_structure=True, b_pct_a=round(b_pct, 2),
            b_valid=False, confidence=0.0,
            notes=[b_msg]
        )
    notes.append(b_msg)
    
    # Step 3: Classify
    c_pct = (req.wave_c.length / req.wave_b.length * 100) if req.wave_b.length > 0 else 0.0
    flat_type, type_msg = classify_flat_type(b_pct, c_pct)
    notes.append(type_msg)
    
    if "deprecated" in flat_type.lower():
        warnings.append("Running Flat is deprecated in this course")
    
    # Step 4: C sub-structure
    c_struct = detect_c_sub_structure(req.wave_c.sub_structure)
    if c_struct:
        notes.append(f"C sub-structure: {c_struct}")
    
    # Step 5: Usability
    usable, confidence, usability_warnings = evaluate_usability(
        req.is_market_end, req.has_confirmation, flat_type
    )
    warnings.extend(usability_warnings)
    
    # Step 6: Knot-untangler
    wave_4_count = req.wave_c.sub_wave_count  # proxy
    knot, knot_msg = recommend_knot_untangler(
        req.count_fails_with_zigzag, wave_4_count
    )
    notes.append(knot_msg)
    
    return FlatTypeResponse(
        type=flat_type,
        b_pct_a=round(b_pct, 2),
        c_pct_b=round(c_pct, 2),
        valid_structure=True,
        b_valid=True,
        usable=usable,
        confidence=confidence,
        c_sub_structure=c_struct,
        knot_untangler=knot,
        warnings=warnings,
        notes=notes
    )
