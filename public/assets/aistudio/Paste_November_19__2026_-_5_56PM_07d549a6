export const useFractalEngine = () => {
  const validation = ref<FractalValidationResponse | null>(null)
  const degrees = ref<DegreeAssignmentResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const validate = async (waves: Wave[], timeframe: string) => {
    loading.value = true
    error.value = null
    try {
      validation.value = await $fetch<FractalValidationResponse>(
        '/api/v1/fractal/validate',
        { method: 'POST', body: { waves, timeframe } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Validation failed'
    } finally {
      loading.value = false
    }
  }

  const assignDegrees = async (nestingDepth: number, timeframe: string) => {
    loading.value = true
    error.value = null
    try {
      degrees.value = await $fetch<DegreeAssignmentResponse>(
        '/api/v1/fractal/degrees',
        { method: 'POST', body: { nesting_depth: nestingDepth, timeframe } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Degree assignment failed'
    } finally {
      loading.value = false
    }
  }

  return { validation, degrees, loading, error, validate, assignDegrees }
}
