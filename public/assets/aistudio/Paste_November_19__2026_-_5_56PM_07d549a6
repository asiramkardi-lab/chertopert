from app.schemas.complex import ComplexRequest

def validate_cardinal_rules(req: ComplexRequest) -> tuple[bool, list[int]]:
    """Validate 3 cardinal rules for complex patterns."""
    violations = []
    
    for comp in req.components:
        waves = comp.waves
        if len(waves) < 2:
            continue
        
        # Rule 1: Wave 2 < 100% Wave 1 (for corrective)
        # Simplified: check if any wave reverses > 100%
        if len(waves) >= 2:
            w1, w2 = waves[0], waves[1]
            w1_len = abs(w1.end_price - w1.start_price)
            w2_len = abs(w2.end_price - w2.start_price)
            if w1_len > 0 and w2_len / w1_len >= 1.0:
                violations.append(1)
        
        # Rule 2: Wave 3 not shortest (if applicable)
        if len(waves) >= 3:
            lengths = [abs(w.end_price - w.start_price) for w in waves[:3]]
            if len(lengths) == 3 and lengths[2] == min(lengths):
                violations.append(2)
    
    return len(violations) == 0, list(set(violations))
