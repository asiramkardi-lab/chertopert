export const useFlatEngine = () => {
  const result = ref<FlatResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (req: FlatRequest) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<FlatResponse>('/api/v1/flat/analyze', {
        method: 'POST', body: req
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
