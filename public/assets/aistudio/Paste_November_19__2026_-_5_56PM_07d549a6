    """Check if all 5 waves have 3 sub-waves."""
    if len(waves) != 5:
        return False
    return all(w.sub_wave_count == 3 for w in waves)

def validate_diagonal_structure(waves: list[Wave]) -> tuple[bool, str]:
    """Validate 3-3-3-3-3 structure and return (is_valid, reason)."""
    if len(waves) != 5:
        return False, f"Expected 5 waves, got {len(waves)}"
    
    for i, w in enumerate(waves, 1):
        if w.sub_wave_count != 3:
            return False, f"Wave {i} has {w.sub_wave_count} sub-waves, expected 3"
    
    return True, "Valid 3-3-3-3-3 structure"
