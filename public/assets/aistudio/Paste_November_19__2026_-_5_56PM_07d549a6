export const useZigzagEngine = () => {
  const result = ref<ZigzagResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (a: Wave, b: Wave, c: Wave, isMarketEnd = false, hasConfirmation = false) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<ZigzagResponse>('/api/v1/zigzag/analyze', {
        method: 'POST',
        body: { wave_a: a, wave_b: b, wave_c: c, is_market_end: isMarketEnd, has_confirmation: hasConfirmation }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
