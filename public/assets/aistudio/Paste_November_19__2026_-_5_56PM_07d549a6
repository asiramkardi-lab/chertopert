<template>
  <UCard>
    <template #header>
      <h3 class="font-semibold">Wave Strength Comparison</h3>
    </template>
    <div class="space-y-3">
      <div v-for="(w, i) in [0, 2, 4]" :key="i" class="flex items-center gap-2">
        <span class="text-sm font-medium w-16">Wave {{ w + 1 }}</span>
        <div class="flex-1 bg-muted rounded-full h-4 overflow-hidden">
          <div
            class="h-full rounded-full transition-all"
            :class="barColor(w)"
            :style="{ width: `${barWidth(w)}%` }"
          />
        </div>
        <span class="text-sm font-mono text-muted w-16 text-right">
          {{ length(w).toFixed(1) }}
        </span>
      </div>
      <UAlert
        v-if="pattern"
        :color="pattern === 'increasing' ? 'warning' : pattern === 'decreasing' ? 'primary' : 'neutral'"
        :title="`Pattern: ${pattern}`"
        :description="patternDescription"
        :icon="pattern === 'increasing' ? 'i-lucide-trending-up' : pattern === 'decreasing' ? 'i-lucide-trending-down' : 'i-lucide-minus'"
      />
    </div>
  </UCard>
</template>

<script setup lang="ts">
const props = defineProps<{ waves: Wave[] }>()

const length = (i: number) => props.waves[i] ? Math.abs(props.waves[i].end_price - props.waves[i].start_price) : 0
const maxLength = computed(() => Math.max(length(0), length(2), length(4), 1))
const barWidth = (i: number) => (length(i) / maxLength.value) * 100

const pattern = computed(() => {
  const l = [length(0), length(2), length(4)]
  if (l[0] < l[1] && l[1] < l[2]) return 'increasing'
  if (l[0] > l[1] && l[1] > l[2]) return 'decreasing'
  return 'mixed'
})

const patternDescription = computed(() => {
  switch (pattern.value) {
    case 'increasing': return 'Anti-Diagonal (wave 5 strongest)'
    case 'decreasing': return 'Diagonal (wave 1 strongest)'
    default: return 'Mixed strengths; invalid diagonal'
  }
})

const barColor = (i: number) => {
  if (pattern.value === 'increasing') return 'bg-warning'
  if (pattern.value === 'decreasing') return 'bg-primary'
  return 'bg-muted'
}
</script>
