from pydantic import BaseModel, Field
from typing import Literal, Optional
from datetime import datetime

class Candle(BaseModel):
    timestamp: datetime
    open: float
    high: float
    low: float
    close: float
    volume: float = 0

class Wave(BaseModel):
    label: str
    start_idx: int
    end_idx: int
    direction: Literal["up", "down"]
    candles: list[Candle] = []
    internal_structure: Optional[int] = None  # 3 or 5
    is_impulsive: bool = False

class RecognitionRequest(BaseModel):
    candles: list[Candle]
    degree: Literal["V", "W", "BOLD", "SIMPLE"] = "SIMPLE"
    timeframe: Literal["daily", "weekly", "monthly", "4h", "1h"] = "daily"
    check_structure: bool = True

class RecognitionResponse(BaseModel):
    valid_wave: bool
    wave_count: int
    internal_structure: Optional[int] = None
    degree: str
    consistency: bool = True
    warnings: list[str] = []

class BottomRequest(BaseModel):
    candles: list[Candle]
    waves: list[Wave] = []

class BottomResponse(BaseModel):
    absolute_bottom_idx: Optional[int] = None
    valid_lows: list[int] = []
    valid_low_invalidated: bool = False
    formed: bool
    reason: str = ""

class StepRequest(BaseModel):
    candles: list[Candle]
    timeframe: Literal["daily", "weekly", "monthly", "4h", "1h"] = "daily"
    max_degree: int = Field(default=4, ge=1, le=5)

class StepResult(BaseModel):
    degree: str
    start_idx: int
    end_idx: int
    waves: list[Wave]

class StepResponse(BaseModel):
    steps: list[StepResult]
    final_count: list[Wave]
    stopped_at_degree: str
    notes: list[str] = []
