from app.schemas.entry import Wave

def detect_fallback(wave_1: Wave, current_price: float, wave_2_extreme: float) -> tuple[bool, str]:
    """Detect 50% pullback fallback (price reached <61.8% then pulled back to 50%)."""
    if wave_1.length == 0:
        return False, "Zero-length wave 1"
    
    if wave_1.end_price > wave_1.start_price:
        base = wave_1.end_price
        direction = -1
    else:
        base = wave_1.end_price
        direction = 1
    
    # Retracement of wave_2_extreme
    extreme_retracement = abs(base - wave_2_extreme) / wave_1.length
    current_retracement = abs(base - current_price) / wave_1.length
    
    # Fallback: extreme was 50-61.8%, current is ~50%
    if 0.5 <= extreme_retracement < 0.618 and abs(current_retracement - 0.5) < 0.02:
        return True, f"Fallback at 50% (extreme was {extreme_retracement*100:.1f}%)"
    
    return False, "No fallback"
