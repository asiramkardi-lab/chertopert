def validate_naming(waves: list[Wave], pattern_type: str) -> tuple[bool, str]:
    """Enforce naming A-B-C-D-E for Triangle, 1-2-3-4-5 for Diagonal."""
    labels = [w.label for w in waves]
    
    if pattern_type == "Triangle":
        if labels != ["A", "B", "C", "D", "E"]:
            return False, f"Triangle must use A-B-C-D-E, got {labels}"
        return True, "Naming valid (A-B-C-D-E)"
    
    if pattern_type == "Diagonal":
        expected = ["1", "2", "3", "4", "5"]
        if labels != expected:
            return False, f"Diagonal must use 1-2-3-4-5, got {labels}"
        return True, "Naming valid (1-2-3-4-5)"
    
    return True, "N/A"
