def validate_all(req: ValidationRequest) -> ValidationResponse:
    violations = []
    violations.extend(validate_rule_1(req.waves))
    violations.extend(validate_rule_2(req.waves))
    violations.extend(validate_rule_3(req.waves))
    
    alternatives = suggest_alternatives(req.waves, violations)
    is_mislabeling, relabel_suggestions = detect_mislabeling(req.waves, violations)
    
    extension = detect_extension(req.waves) if req.check_extension else None
    
    # If alternative exists and not mislabeling → valid
    has_valid_alternative = len(alternatives) > 0 and not is_mislabeling
    valid = len(violations) == 0 or has_valid_alternative
    
    return ValidationResponse(
        valid=valid,
        violations=violations,
        alternatives=alternatives,
        is_mislabeling=is_mislabeling,
        relabeling_suggestions=relabel_suggestions,
        extension=extension
    )
