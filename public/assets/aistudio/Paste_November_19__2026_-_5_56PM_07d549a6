export const useDiagonalEngine = () => {
  const classification = ref<DiagonalResponse | null>(null)
  const correction = ref<CorrectionResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const classify = async (waves: Wave[], location: string, rule3: boolean) => {
    loading.value = true
    error.value = null
    try {
      classification.value = await $fetch<DiagonalResponse>('/api/v1/diagonal/classify', {
        method: 'POST',
        body: { waves, wave_location: location, rule3_violated: rule3 }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Classification failed'
    } finally {
      loading.value = false
    }
  }

  const predictCorrection = async (diagonalType: string, startPrice: number, endPrice: number) => {
    try {
      correction.value = await $fetch<CorrectionResponse>('/api/v1/diagonal/correction', {
        method: 'POST',
        body: { diagonal_type: diagonalType, diagonal_start_price: startPrice, diagonal_end_price: endPrice }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Correction prediction failed'
    }
  }

  return { classification, correction, loading, error, classify, predictCorrection }
}
