export const useExtensionEngine = () => {
  const result = ref<ExtensionResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (req: ExtensionRequest) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<ExtensionResponse>('/api/v1/extension/analyze', {
        method: 'POST', body: req
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
