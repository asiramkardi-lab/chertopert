from app.schemas.projection import ThreePoint, ProjectionLevel, ProjectionRequest, ProjectionResponse

PROJECTION_LEVELS = [61.8, 100.0, 127.0, 161.8, 261.8]

def compute_projection(req: ProjectionRequest) -> ProjectionResponse:
    """Compute three-point Fibonacci projection (X→Y→Z)."""
    if req.points.x == req.points.y:
        return ProjectionResponse(
            levels=[], valid=False, error="Zero-length wave 1",
            draw_from=req.points.x, draw_to=req.points.y, draw_release=req.points.z
        )
    
    if req.target_wave == "5" and req.previous_pair == "1-2":
        return ProjectionResponse(
            levels=[], valid=False,
            error="Use waves 3-4 for wave 5 projection, not 1-2",
            draw_from=req.points.x, draw_to=req.points.y, draw_release=req.points.z
        )
    
    if req.target_wave == "3" and req.previous_pair == "3-4":
        return ProjectionResponse(
            levels=[], valid=False,
            error="Use waves 1-2 for wave 3 projection, not 3-4",
            draw_from=req.points.x, draw_to=req.points.y, draw_release=req.points.z
        )
    
    wave_length = abs(req.points.y - req.points.x)
    levels = []
    
    for pct in PROJECTION_LEVELS:
        ratio = pct / 100.0
        if req.points.direction == "up":
            price = req.points.z + wave_length * ratio
        else:
            price = req.points.z - wave_length * ratio
        
        levels.append(ProjectionLevel(level=pct, price=round(price, 4)))
    
    return ProjectionResponse(
        levels=levels, valid=True,
        draw_from=req.points.x,
        draw_to=req.points.y,
        draw_release=req.points.z
    )
