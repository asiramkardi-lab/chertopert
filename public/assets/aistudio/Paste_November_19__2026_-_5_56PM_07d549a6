from app.schemas.projection import OverlapRequest, OverlapResponse

def check_overlap(req: OverlapRequest) -> OverlapResponse:
    """Check if TMV and PRZ overlap."""
    if req.prz_start <= req.tmv <= req.prz_end:
        return OverlapResponse(type="full", confidence=0.95, gap_pct=0.0)
    
    # Partial: TMV within 5% of PRZ boundary
    prz_range = req.prz_end - req.prz_start
    if prz_range > 0:
        gap = min(abs(req.tmv - req.prz_start), abs(req.tmv - req.prz_end))
        gap_pct = gap / prz_range * 100
        
        if gap_pct <= 5.0:
            return OverlapResponse(type="partial", confidence=0.75, gap_pct=gap_pct)
    
    return OverlapResponse(type="none", confidence=0.5, gap_pct=100.0)
