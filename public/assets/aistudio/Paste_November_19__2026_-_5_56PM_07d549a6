from app.schemas.recognition import Candle, Wave, RecognitionResponse

def detect_internal_structure(candles: list[Candle]) -> Optional[int]:
    """Detect if a candle sequence has 5-wave or 3-wave internal structure."""
    # Simplified: use pivot detection to count swings
    pivots = find_pivots(candles)
    if len(pivots) >= 6:  # 5 waves = 6 pivots (start + 5 ends)
        return 5
    elif len(pivots) >= 4:  # 3 waves = 4 pivots
        return 3
    return None

def find_pivots(candles: list[Candle], window: int = 3) -> list[int]:
    pivots = []
    for i in range(window, len(candles) - window):
        window_slice = candles[i-window:i+window+1]
        if candles[i].high == max(c.high for c in window_slice):
            pivots.append(i)
        elif candles[i].low == min(c.low for c in window_slice):
            pivots.append(i)
    return pivots

def recognize_single_movement(candles: list[Candle]) -> RecognitionResponse:
    """Recognize candles as a single movement, not multiple."""
    internal = detect_internal_structure(candles)
    
    if internal == 5:
        return RecognitionResponse(
            valid_wave=True,
            wave_count=1,
            internal_structure=5,
            degree="SIMPLE",
            warnings=[]
        )
    elif internal == 3:
        return RecognitionResponse(
            valid_wave=True,
            wave_count=1,
            internal_structure=3,
            degree="SIMPLE",
            warnings=[]
        )
    else:
        # No clear internal structure — treat as single movement
        ups = sum(1 for c in candles if c.close > c.open)
        downs = sum(1 for c in candles if c.close < c.open)
        direction = "up" if ups > downs else "down"
        
        return RecognitionResponse(
            valid_wave=True,
            wave_count=1,
            internal_structure=None,
            degree="SIMPLE",
            warnings=[f"Single movement detected (no clear 3/5 structure, direction={direction})"]
        )
