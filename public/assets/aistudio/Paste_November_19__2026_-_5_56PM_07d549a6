router = APIRouter(prefix="/api/v1/fibonacci", tags=["fibonacci"])

@router.post("/levels", response_model=FibResponse)
async def levels_endpoint(req: FibRequest):
    if req.wave.start_price == req.wave.end_price:
        raise HTTPException(400, "Zero-length wave")
    
    if req.mode == "retracement":
        return compute_retracement(req.wave)
    else:
        return compute_extension(req.wave)

@router.post("/golden", response_model=GoldenResponse)
async def golden_endpoint(req: GoldenRequest):
    if req.wave.start_price == req.wave.end_price:
        raise HTTPException(400, "Zero-length wave")
    return find_golden_level(req)
