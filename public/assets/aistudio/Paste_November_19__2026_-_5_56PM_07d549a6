from app.schemas.non_ideal import Wave, Wave5TerminalResponse
from app.services.terminal_service import detect_terminal

def detect_wave5_terminal(waves: list[Wave]) -> Wave5TerminalResponse:
    """Detect if wave 5 of an ideal cycle is a Terminal."""
    wave_map = {w.label: w for w in waves}
    
    if "5" not in wave_map:
        return Wave5TerminalResponse(
            wave_5_terminal=False,
            predict_wave_a_100pct=False,
            confidence=0.0
        )
    
    # Check if wave 5 itself is a terminal (has sub-waves)
    w5 = wave_map["5"]
    if w5.sub_waves and len(w5.sub_waves) >= 5:
        # Treat wave 5's sub-waves as a mini 5-wave structure
        terminal_result = detect_terminal(w5.sub_waves)
        if terminal_result.pattern == "Terminal" and terminal_result.valid:
            return Wave5TerminalResponse(
                wave_5_terminal=True,
                predict_wave_a_100pct=True,
                confidence=0.85
            )
    
    return Wave5TerminalResponse(
        wave_5_terminal=False,
        predict_wave_a_100pct=False,
        confidence=0.0
    )
