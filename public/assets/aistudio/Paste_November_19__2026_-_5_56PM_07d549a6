from app.schemas.rules import Wave, RuleViolation, AlternativePattern

def suggest_alternatives(
    waves: list[Wave], 
    violations: list[RuleViolation]
) -> list[AlternativePattern]:
    alternatives = []
    wave_map = {w.label: w for w in waves}
    
    # Rule 3 violation → Terminal, Anti-Terminal, or Diagonal
    if any(v.rule == 3 for v in violations):
        if "3" in wave_map and "5" in wave_map:
            w3_len = wave_map["3"].length
            w5_len = wave_map["5"].length
            
            # Check for Diagonal: 3-3-3-3-3 structure
            if all(len(w.sub_waves) == 3 for w in waves if w.label in ["1","2","3","4","5"]):
                alternatives.append(AlternativePattern(
                    name="Diagonal",
                    reason="3-3-3-3-3 structure detected",
                    confidence=0.85
                ))
            elif w5_len < w3_len:
                alternatives.append(AlternativePattern(
                    name="Terminal",
                    reason="Wave 5 truncated (shorter than wave 3) + Rule 3 violation",
                    confidence=0.9
                ))
            elif w5_len > w3_len:
                alternatives.append(AlternativePattern(
                    name="Anti-Terminal",
                    reason="Wave 5 extended (longer than wave 3) + Rule 3 violation",
                    confidence=0.8
                ))
    
    # Rule 1 violation → Anti-Cycle or Irregular Flat
    if any(v.rule == 1 for v in violations):
        v = next(v for v in violations if v.rule == 1)
        
        if v.wave_label == "B":
            alternatives.append(AlternativePattern(
                name="Irregular Flat",
                reason="Wave B > 100% of wave A (irregular flat)",
                confidence=0.85
            ))
        elif v.wave_label == "2":
            # Check if first phase is 3-wave (anti-cycle)
            if "1" in wave_map and len(wave_map["1"].sub_waves) == 3:
                alternatives.append(AlternativePattern(
                    name="Anti-Cycle",
                    reason="Wave 1 is 3-wave + Rule 1 violation (anti-cycle structure)",
                    confidence=0.8
                ))
    
    return alternatives
