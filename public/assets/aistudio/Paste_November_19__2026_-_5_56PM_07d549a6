def classify_flat_type(b_pct: float, c_pct: float) -> tuple[str, str]:
    """Classify Flat into 8 types with precise ratios."""
    # Running: B > 100, C < 61.8 (deprecated)
    if b_pct > 100 and c_pct < 61.8:
        return "Running (deprecated)", f"B={b_pct:.1f}%, C={c_pct:.1f}% (deprecated type)"
    
    # Irregular-Extended: B > 138.2, C > 100
    if b_pct > 138.2 and c_pct > 100:
        return "Irregular-Extended", f"B={b_pct:.1f}% (>138.2%), C={c_pct:.1f}% (>100%)"
    
    # Irregular-Deficient: B > 100, C 61.8-81
    if b_pct > 100 and 61.8 <= c_pct < 81:
        return "Irregular-Deficient", f"B={b_pct:.1f}% (>100%), C={c_pct:.1f}% (61.8-81%)"
    
    # Irregular: B 100-138.2, C 81-100
    if 100 <= b_pct <= 138.2 and 81 <= c_pct <= 100:
        return "Irregular", f"B={b_pct:.1f}% (100-138.2%), C={c_pct:.1f}% (81-100%)"
    
    # Double-Deficient: B 61.8-81, C 61.8-81
    if 61.8 <= b_pct < 81 and 61.8 <= c_pct < 81:
        return "Double-Deficient", f"B={b_pct:.1f}% (61.8-81%), C={c_pct:.1f}% (61.8-81%)"
    
    # B-Deficient: B 61.8-81, C 81-100
    if 61.8 <= b_pct < 81 and 81 <= c_pct <= 100:
        return "B-Deficient", f"B={b_pct:.1f}% (61.8-81%), C={c_pct:.1f}% (81-100%)"
    
    # C-Deficient: B 81-100, C 61.8-81
    if 81 <= b_pct <= 100 and 61.8 <= c_pct < 81:
        return "C-Deficient", f"B={b_pct:.1f}% (81-100%), C={c_pct:.1f}% (61.8-81%)"
    
    # Regular: B 81-100, C 81-100
    if 81 <= b_pct <= 100 and 81 <= c_pct <= 100:
        return "Regular", f"B={b_pct:.1f}% (81-100%), C={c_pct:.1f}% (81-100%)"
    
    return "Unknown", f"B={b_pct:.1f}%, C={c_pct:.1f}% (no type matched)"
