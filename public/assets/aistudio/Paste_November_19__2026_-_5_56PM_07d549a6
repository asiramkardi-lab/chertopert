from app.schemas.projection import ThreePoint, TMVRequest, TMVResponse, TMVResult

def compute_tmv(req: TMVRequest) -> TMVResponse:
    """Compute TMV Prime, Ideal, Alternate."""
    wave_length = abs(req.points.y - req.points.x)
    
    if req.points.direction == "up":
        ideal = req.points.z + wave_length * 1.0
        alternate = req.points.z + wave_length * 1.618
    else:
        ideal = req.points.z - wave_length * 1.0
        alternate = req.points.z - wave_length * 1.618
    
    return TMVResponse(
        tmv=TMVResult(
            prime=req.previous_wave_extreme,
            ideal=round(ideal, 4),
            alternate=round(alternate, 4),
            direction=req.points.direction
        ),
        previous_pair="1-2"
    )
