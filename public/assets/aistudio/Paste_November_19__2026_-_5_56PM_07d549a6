from app.schemas.non_ideal import Wave, NonIdealResponse

EXTENDED_ALLOWED_POSITIONS = {"B", "C"}

def detect_anti_cycle(
    waves: list[Wave],
    position: str = "2",
    is_market_end: bool = False
) -> NonIdealResponse:
    """Detect Anti-Cycle and distinguish harmonic vs extended."""
    notes = []
    
    if len(waves) < 2:
        return NonIdealResponse(valid=False, notes=["Insufficient waves"])
    
    phase1 = waves[0]
    phase2 = waves[1]
    
    # Check structure: phase1 must be 3-wave, phase2 must be 5-wave
    p1_structure = len(phase1.sub_waves) if phase1.sub_waves else None
    p2_structure = len(phase2.sub_waves) if phase2.sub_waves else None
    
    if p1_structure != 3:
        return NonIdealResponse(
            valid=False,
            notes=[f"Phase 1 is {p1_structure}-wave, expected 3"]
        )
    
    if p2_structure != 5:
        return NonIdealResponse(
            valid=False,
            notes=[f"Phase 2 is {p2_structure}-wave, expected 5"]
        )
    
    # Check Rule 1 violation: phase 2 retraces 100%+ of phase 1
    if phase1.direction == "up":
        phase1_end = max(phase1.start_price, phase1.end_price)
        phase2_end = phase2.end_price
        retracement = (phase1_end - phase2_end) / phase1.length
    else:
        phase1_end = min(phase1.start_price, phase1.end_price)
        phase2_end = phase2.end_price
        retracement = (phase2_end - phase1_end) / phase1.length
    
    is_extended = retracement >= 1.0
    
    # Validate position
    if is_extended and position not in EXTENDED_ALLOWED_POSITIONS:
        # Check sub-wave positions
        if not _is_allowed_subwave_position(position, waves):
            return NonIdealResponse(
                pattern="Anti-Cycle",
                valid=False,
                violations=[{"rule": 1, "description": f"Extended anti-cycle in position {position} not allowed"}],
                notes=["Extended anti-cycle only allowed in waves B, C, or sub-waves 2-3/4-5 of A/C"]
            )
    
    # Market-end 100% rule
    if is_market_end and not is_extended:
        return NonIdealResponse(
            pattern="Anti-Cycle",
            valid=False,
            violations=[{"rule": "Market-End", "description": "Extended anti-cycle required at market end"}],
            notes=["At market end, phase 2 must retrace 100% of phase 1's last wave"]
        )
    
    pattern_type = "Anti-Cycle"
    type_label = "extended" if is_extended else "harmonic"
    notes.append(f"Anti-Cycle ({type_label}) detected: Rule 1 violated, structure 3-5")
    
    return NonIdealResponse(
        pattern=pattern_type,
        valid=True,
        notes=notes
    )

def _is_allowed_subwave_position(position: str, waves: list[Wave]) -> bool:
    """Check if position is a sub-wave where extended anti-cycle is allowed."""
    # Sub-waves 2-3 and 4-5 of A or C
    return position in {"A.2", "A.3", "A.4", "A.5", "C.2", "C.3", "C.4", "C.5"}
