export const useRecognitionEngine = () => {
  const validation = ref<RecognitionResponse | null>(null)
  const bottom = ref<BottomResponse | null>(null)
  const steps = ref<StepResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const validateWave = async (candles: Candle[]) => {
    loading.value = true
    error.value = null
    try {
      validation.value = await $fetch<RecognitionResponse>(
        '/api/v1/recognize/validate-wave',
        { method: 'POST', body: { candles, degree: 'SIMPLE', timeframe: 'daily' } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Validation failed'
    } finally {
      loading.value = false
    }
  }

  const detectBottom = async (candles: Candle[]) => {
    try {
      bottom.value = await $fetch<BottomResponse>(
        '/api/v1/recognize/bottom',
        { method: 'POST', body: { candles, waves: [] } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Bottom detection failed'
    }
  }

  const stepCount = async (candles: Candle[], timeframe: string, maxDegree: number) => {
    loading.value = true
    error.value = null
    try {
      steps.value = await $fetch<StepResponse>(
        '/api/v1/recognize/step-count',
        { method: 'POST', body: { candles, timeframe, max_degree: maxDegree } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Step counting failed'
    } finally {
      loading.value = false
    }
  }

  return { validation, bottom, steps, loading, error, validateWave, detectBottom, stepCount }
}
