from app.schemas.rules import Wave, RuleViolation, RelabelSuggestion

def detect_mislabeling(
    waves: list[Wave],
    violations: list[RuleViolation]
) -> tuple[bool, list[RelabelSuggestion]]:
    """Detect if violation is due to mislabeling vs real alternative pattern."""
    suggestions = []
    wave_map = {w.label: w for w in waves}
    
    for v in violations:
        if v.rule == 3 and "3" in wave_map:
            w3 = wave_map["3"]
            # If wave 3 is impulsive (short), suggest making it extended
            if w3.is_impulsive:
                suggestions.append(RelabelSuggestion(
                    action="Reclassify wave 3 as extended (momentum)",
                    affected_waves=["3", "4"],
                    expected_fix="Wave 3 becomes longer, wave 4 no longer overlaps wave 1"
                ))
        
        if v.rule == 2 and "3" in wave_map:
            w3 = wave_map["3"]
            # If wave 3 is short, try making it wave 1 or 5
            suggestions.append(RelabelSuggestion(
                action="Reclassify wave 3 as wave 1 or 5",
                affected_waves=["1", "2", "3", "4", "5"],
                expected_fix="Wave 3 is no longer the shortest"
            ))
        
        if v.rule == 1 and v.wave_label == "2" and "1" in wave_map:
            suggestions.append(RelabelSuggestion(
                action="Reclassify wave 1 as wave A, wave 2 as wave B",
                affected_waves=["1", "2"],
                expected_fix="Wave B may be a valid irregular flat"
            ))
    
    is_mislabeling = len(suggestions) > 0
    return is_mislabeling, suggestions
