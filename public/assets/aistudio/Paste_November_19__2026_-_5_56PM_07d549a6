def detect_impulsive_vs_fractal(
    candles_high_tf: list[Candle],
    candles_low_tf: list[Candle]
) -> dict:
    """
    Distinguish impulsive (no internal structure) from fractal (has internal 5-wave).
    """
    from app.services.movement_service import detect_internal_structure
    
    # Check if low timeframe has 5-wave structure
    low_tf_structure = detect_internal_structure(candles_low_tf)
    
    if low_tf_structure == 5:
        return {
            "type": "fractal",
            "internal_structure": 5,
            "reason": "5-wave structure found in lower timeframe"
        }
    elif low_tf_structure == 3:
        return {
            "type": "corrective",
            "internal_structure": 3,
            "reason": "3-wave structure found in lower timeframe (may be corrective)"
        }
    else:
        return {
            "type": "impulsive",
            "internal_structure": None,
            "assumed_structure": 5,
