from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str
    start_price: float
    end_price: float
    sub_waves: list["Wave"] = []
    strength: float = 0.0  # normalized strength metric

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

    @property
    def sub_wave_count(self) -> int:
        return len(self.sub_waves)

class DiagonalRequest(BaseModel):
    waves: list[Wave]  # Must be exactly 5 waves
    wave_location: Literal["1", "3", "5", "A", "C"] = "5"
    rule3_violated: bool = True

class DiagonalResponse(BaseModel):
    detected: bool
    type: Optional[Literal["Leading Ideal", "Leading Anti", "Impulsive", "Anti-Diagonal", "Ending Diagonal"]] = None
    location: str
    common_location: bool = True
    warning: Optional[str] = None
    correction_depth: Optional[str] = None
    correction_target: Optional[str] = None
    confidence: float = Field(ge=0, le=1)
    notes: list[str] = []

class CorrectionRequest(BaseModel):
    diagonal_type: Literal["normal", "anti", "ending"]
    diagonal_start_price: float
    diagonal_end_price: float

class CorrectionResponse(BaseModel):
    depth_pct_range: str
    target_price_range: str
    confidence: float = Field(ge=0, le=1)
