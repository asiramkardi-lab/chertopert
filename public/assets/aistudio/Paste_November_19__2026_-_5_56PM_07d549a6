def identify_continuation(
    main_trend: str,
    breakout_direction: str | None
) -> tuple[str | None, str]:
    """Identify continuation behavior after Triangle."""
    if breakout_direction is None:
        return None, "Await breakout"
    
    if main_trend == "up" and breakout_direction == "up":
        return "up", "Continuation: uptrend resumes"
    elif main_trend == "down" and breakout_direction == "down":
        return "down", "Continuation: downtrend resumes"
    elif breakout_direction != main_trend:
        return "reversal", "Rare: breakout against main trend"
    
    return None, "Unclear continuation"
