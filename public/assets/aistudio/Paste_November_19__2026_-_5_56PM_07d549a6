from app.schemas.rules import Wave, RuleViolation

MOTIVE_LABELS = {"1", "3", "5", "A", "C"}
CORRECTIVE_LABELS = {"2", "4", "B"}

def validate_rule_1(waves: list[Wave]) -> list[RuleViolation]:
    """Rule 1: Corrective wave cannot retrace 100%+ of its motive wave."""
    violations = []
    pairs = [("1", "2"), ("3", "4"), ("A", "B")]
    
    wave_map = {w.label: w for w in waves}
    
    for motive_label, corrective_label in pairs:
        if motive_label not in wave_map or corrective_label not in wave_map:
            continue
        motive = wave_map[motive_label]
        corrective = wave_map[corrective_label]
        
        # Check if corrective retraces >= 100% of motive
        if motive.direction == "up":
            retracement = (motive.end_price - corrective.end_price) / motive.length
            if retracement >= 1.0:
                violations.append(RuleViolation(
                    rule=1,
                    severity="error",
                    description=f"Wave {corrective_label} retraced {retracement*100:.1f}% of wave {motive_label} (must be <100%)",
                    wave_label=corrective_label
                ))
        else:  # motive down
            retracement = (corrective.end_price - motive.end_price) / motive.length
            if retracement >= 1.0:
                violations.append(RuleViolation(
                    rule=1,
                    severity="error",
                    description=f"Wave {corrective_label} retraced {retracement*100:.1f}% of wave {motive_label} (must be <100%)",
                    wave_label=corrective_label
                ))
    
    return violations


def validate_rule_2(waves: list[Wave]) -> list[RuleViolation]:
    """Rule 2: Wave 3 cannot be the shortest among waves 1, 3, 5."""
    violations = []
    wave_map = {w.label: w for w in waves}
    
    if not all(label in wave_map for label in ["1", "3", "5"]):
        return violations
    
    lengths = {label: wave_map[label].length for label in ["1", "3", "5"]}
    shortest = min(lengths, key=lengths.get)
    
    if shortest == "3":
        violations.append(RuleViolation(
            rule=2,
            severity="error",
            description=f"Wave 3 is the shortest (length={lengths['3']:.2f}, wave1={lengths['1']:.2f}, wave5={lengths['5']:.2f})",
            wave_label="3"
        ))
    
    return violations


def validate_rule_3(waves: list[Wave]) -> list[RuleViolation]:
    """Rule 3: Wave 4 cannot overlap wave 1."""
    violations = []
    wave_map = {w.label: w for w in waves}
    
    if "1" not in wave_map or "4" not in wave_map:
        return violations
    
    w1 = wave_map["1"]
    w4 = wave_map["4"]
    
    # For uptrend: wave 4 low must be > wave 1 high
    if w1.direction == "up":
        w1_high = max(w1.start_price, w1.end_price)
        w4_low = min(w4.start_price, w4.end_price)
        if w4_low < w1_high:
            overlap_pct = (w1_high - w4_low) / w1_high * 100
            violations.append(RuleViolation(
                rule=3,
                severity="warning",
                description=f"Wave 4 overlaps wave 1 by {overlap_pct:.2f}% (wave4 low={w4_low:.2f}, wave1 high={w1_high:.2f})",
                wave_label="4"
            ))
    else:  # downtrend
        w1_low = min(w1.start_price, w1.end_price)
        w4_high = max(w4.start_price, w4.end_price)
        if w4_high > w1_low:
            overlap_pct = (w4_high - w1_low) / w1_low * 100
            violations.append(RuleViolation(
                rule=3,
                severity="warning",
                description=f"Wave 4 overlaps wave 1 by {overlap_pct:.2f}% (wave4 high={w4_high:.2f}, wave1 low={w1_low:.2f})",
                wave_label="4"
            ))
    
    return violations
