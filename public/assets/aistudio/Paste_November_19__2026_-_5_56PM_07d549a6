from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str  # "1", "2", "3", "4", "5", "A", "B", "C"
    start_price: float
    end_price: float
    sub_wave_count: int = 3
    structure: Optional[Literal["impulsive", "zigzag", "flat", "triangle", "diagonal", "unknown"]] = None

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class CharacteristicsRequest(BaseModel):
    waves: list[Wave]  # 8 waves: 1-5, A, B, C

class WaveFeatures(BaseModel):
    label: str
    weak: Optional[bool] = None
    strong: Optional[bool] = None
    short: Optional[bool] = None
    structure: Optional[str] = None
    retracement_pct: Optional[float] = None
    extension: Optional[str] = None
    volume_note: Optional[str] = None
    characteristics_valid: bool = True

class CharacteristicsResponse(BaseModel):
    features: list[WaveFeatures]
    overall_confidence: float = Field(ge=0, le=1)
    warnings: list[str] = []
    notes: list[str] = []
