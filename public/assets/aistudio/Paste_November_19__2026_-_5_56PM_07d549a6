def evaluate_usability(
    is_market_end: bool,
    has_confirmation: bool,
    flat_type: str
) -> tuple[bool, float, list[str]]:
    """Determine if Flat is usable at market end."""
    warnings = []
    
    if not is_market_end:
        # Past data: always usable
        confidence = 0.8
        if flat_type in ("Double-Deficient", "Running (deprecated)"):
            confidence -= 0.1
            warnings.append(f"{flat_type} is low-confidence")
        return True, confidence, warnings
    
    # Market end
    if has_confirmation:
        confidence = 0.5
        if flat_type in ("Double-Deficient", "Running (deprecated)"):
            confidence -= 0.15
            warnings.append(f"{flat_type} at market end is very risky")
        return True, confidence, warnings
    
    return False, 0.3, ["Flat at market end without confirmation: too many alternatives"]
