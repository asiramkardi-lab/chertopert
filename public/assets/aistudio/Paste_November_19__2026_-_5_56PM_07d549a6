from app.services.c_sub_service import detect_c_sub_structure
from app.services.market_end_service import compute_confidence

def analyze_flat(req: FlatRequest) -> FlatResponse:
    notes = []
    
    # Step 1: Structure
    is_335, struct_msg = detect_structure(req.wave_a, req.wave_b, req.wave_c)
    if not is_335:
        return FlatResponse(
            detected=False, confidence=0.0,
            notes=[struct_msg]
        )
    
    # Step 2: B rule
    b_pct = compute_b_pct(req.wave_a, req.wave_b)
    b_ok, b_msg = validate_b_rule(b_pct)
    
    # Distinguish
    dist_type, dist_conf = distinguish_flat_vs_simple(
        req.wave_a, req.wave_b, req.wave_c, b_pct
    )
    
    if not b_ok:
        return FlatResponse(
            detected=False, b_pct_a=round(b_pct, 2),
            confidence=dist_conf,
            notes=[struct_msg, b_msg, f"Likely: {dist_type}"]
        )
    
    # Step 3: Classify
    c_pct = compute_c_pct(req.wave_b, req.wave_c)
    flat_type, type_msg = classify_type(b_pct, c_pct)
    
    # Step 4: C sub-structure
    c_struct = detect_c_sub_structure(req.wave_c.sub_structure)
    
    # Step 5: Confidence
    confidence, conf_warnings = compute_confidence(
        req.is_market_end, req.has_confirmation, flat_type
    )
    
    notes.append(struct_msg)
    notes.append(b_msg)
    notes.append(type_msg)
    if c_struct:
        notes.append(f"Wave C sub-structure: {c_struct}")
    
    return FlatResponse(
        detected=True,
        type=flat_type,
        b_pct_a=round(b_pct, 2),
        c_pct_b=round(c_pct, 2),
        c_structure=c_struct,
        confidence=confidence,
        warnings=conf_warnings,
        notes=notes
    )
