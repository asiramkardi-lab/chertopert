export const useComplexEngine = () => {
  const result = ref<ComplexResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (req: ComplexRequest) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<ComplexResponse>('/api/v1/complex/analyze', {
        method: 'POST', body: req
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
