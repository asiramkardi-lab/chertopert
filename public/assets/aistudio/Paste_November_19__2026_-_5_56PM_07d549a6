from app.schemas.recognition import Candle, Wave, BottomResponse

def detect_absolute_bottom(candles: list[Candle]) -> BottomResponse:
    """Find the absolute bottom (lowest low) in the entire candle series."""
    if not candles:
        return BottomResponse(
            formed=False,
            reason="No candles"
        )
    
    lowest_idx = min(range(len(candles)), key=lambda i: candles[i].low)
    
    return BottomResponse(
        absolute_bottom_idx=lowest_idx,
        valid_lows=[],
        formed=True,
        reason=f"Absolute bottom found at index {lowest_idx} (low={candles[lowest_idx].low})"
    )

def detect_valid_lows(
    candles: list[Candle],
    cycles: list[dict]
) -> BottomResponse:
    """
    Detect valid lows (end of complete cycles).
    A valid low is invalidated if retraced 100% by next wave 2.
    """
    if not candles:
        return BottomResponse(formed=False, reason="No candles")
    
    absolute_bottom_idx = min(range(len(candles)), key=lambda i: candles[i].low)
    valid_lows = []
    invalidated = False
    
    for cycle in cycles:
        cycle_end_idx = cycle.get("end_idx")
        if cycle_end_idx is None:
            continue
        
        # Check if next wave 2 retraced 100%
        next_wave_2 = cycle.get("next_wave_2")
        if next_wave_2 and next_wave_2.get("end_price", 0) <= candles[absolute_bottom_idx].low:
            invalidated = True
            continue
        
        valid_lows.append(cycle_end_idx)
    
    return BottomResponse(
        absolute_bottom_idx=absolute_bottom_idx,
        valid_lows=valid_lows,
        valid_low_invalidated=invalidated,
        formed=True,
        reason=f"Found {len(valid_lows)} valid lows"
    )
