export const useTriangleAdvancedEngine = () => {
  const result = ref<TriangleResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (req: TriangleRequest) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<TriangleResponse>('/api/v1/triangle-advanced/analyze', {
        method: 'POST', body: req
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
