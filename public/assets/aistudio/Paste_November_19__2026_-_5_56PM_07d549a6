from app.schemas.zigzag import ZigzagRequest, ZigzagResponse
from app.services.structure_service import detect_structure
from app.services.rule_service import validate_c_over_b
from app.services.classify_service import classify_by_wave_c
from app.services.post_pattern_service import predict_post_pattern
from app.services.ab_cd_service import detect_ab_cd
from app.services.market_end_service import compute_confidence

def analyze_zigzag(req: ZigzagRequest) -> ZigzagResponse:
    notes = []
    
    # Step 1: Detect structure
    structure, zz_type = detect_structure(req.wave_a, req.wave_b, req.wave_c)
    if zz_type == "Invalid":
        return ZigzagResponse(
            detected=False, structure=structure,
            confidence=0.0,
            notes=[f"Invalid structure: {structure}"]
        )
    
    # Step 2: Validate C >= 100% B
    rule_ok, rule_msg = validate_c_over_b(req.wave_a, req.wave_b, req.wave_c)
    if not rule_ok:
        return ZigzagResponse(
            detected=False, type=zz_type, structure=structure,
            confidence=0.0,
            warnings=[rule_msg],
            notes=["C must cover 100% of B"]
        )
    
    # Step 3: Classify by C size
    c_class, c_msg = classify_by_wave_c(req.wave_a, req.wave_c)
    if c_class == "Invalid":
        return ZigzagResponse(
            detected=False, type=zz_type, structure=structure,
            confidence=0.0,
            warnings=[c_msg]
        )
    
    # Step 4: Predict post-pattern
    target, basis = predict_post_pattern(
        req.wave_a, req.wave_b, req.wave_c, c_class
    )
    
    # Step 5: AB=CD detection
    ab_cd, ab_tol = detect_ab_cd(req.wave_a, req.wave_c)
    
    # Step 6: Confidence
    confidence, conf_warnings = compute_confidence(
        req.is_market_end, req.has_confirmation
    )
    
    notes.append(f"Structure: {structure}")
    notes.append(f"Type: {zz_type}")
    notes.append(f"Class: {c_class} ({c_msg})")
    
    return ZigzagResponse(
        detected=True,
        type=zz_type,
        structure=structure,
        wave_c_class=c_class,
        post_pattern_target=target,
        post_pattern_basis=basis,
        ab_cd=ab_cd,
        ab_cd_tolerance=ab_tol,
        confidence=confidence,
        warnings=conf_warnings,
        notes=notes
    )
