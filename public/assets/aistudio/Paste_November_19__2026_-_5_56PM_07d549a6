from app.schemas.zigzag import Wave

def detect_ab_cd(a: Wave, c: Wave, tolerance_pct: float = 5.0) -> tuple[bool, float]:
    """Detect AB=CD subset (A length ≈ C length)."""
    if a.length == 0:
        return False, 0.0
    
    diff_pct = abs(a.length - c.length) / a.length * 100
    ab_cd = diff_pct <= tolerance_pct
    
    return ab_cd, round(diff_pct, 2)
