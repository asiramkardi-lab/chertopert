<script setup lang="ts">
const props = defineProps<{ waves: Wave[] }>()

const wavePath = computed(() => {
  if (!props.waves.length) return ''
  const points = props.waves.flatMap((w, i) => {
    const x = 50 + (i / 4) * 300
    const y = 200 - ((w.end_price - 100) / 200) * 150
    return `${x},${y}`
  })
  return `50,125 ${points.join(' ')}`
})

const labelPositions = computed(() => props.waves.map((w, i) => ({
  x: 50 + (i / 4) * 300,
  y: 200 - ((w.end_price - 100) / 200) * 150 - 10
})))
</script>
