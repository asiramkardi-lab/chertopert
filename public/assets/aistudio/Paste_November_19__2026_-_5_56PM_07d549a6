from pydantic import BaseModel, Field
from typing import Literal, Optional

class MotiveWave(BaseModel):
    start_price: float
    end_price: float
    direction: Literal["up", "down"]

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class FibLevel(BaseModel):
    level: float  # e.g., 61.8
    price: float
    sr_importance: Literal["none", "very_weak", "moderate", "strong", "very_strong"]
    id_importance: bool
    acceleration: bool = False

class FibRequest(BaseModel):
    wave: MotiveWave
    mode: Literal["retracement", "extension"] = "retracement"

class FibResponse(BaseModel):
    levels: list[FibLevel]
    draw_from: float
    draw_to: float
    orientation: Literal["X→Y", "Y→X"]
    mode: str

class GoldenRequest(BaseModel):
    price: float
    wave: MotiveWave
    tolerance_pct: float = Field(default=1.0, ge=0, le=5)

class GoldenResponse(BaseModel):
    golden_level: Optional[float] = None
    distance_pct: float = 0.0
    nearest_level: Optional[float] = None
    matched: bool = False
