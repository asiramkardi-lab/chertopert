def detect_ideal_completion(
    waves: list[Wave],
    end_idx: int,
    total_range: int
) -> tuple[bool, str]:
    """Detect if triangle ends before 3rd box (ideal)."""
    if total_range <= 0:
        return False, "Invalid range"
    
    position_in_range = end_idx / total_range
    
    # 3rd box = 66.7-100%
    if position_in_range < 0.667:
        return True, f"Ends before 3rd box ({position_in_range*100:.1f}%) - ideal"
    elif position_in_range < 0.9:
        return False, f"Ends in 3rd box ({position_in_range*100:.1f}%) - standard"
    else:
        return False, f"Ends after 3rd box ({position_in_range*100:.1f}%) - weak"
