export const useCharacteristicsEngine = () => {
  const result = ref<CharacteristicsResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const analyze = async (waves: Wave[]) => {
    loading.value = true
    error.value = null
    try {
      result.value = await $fetch<CharacteristicsResponse>('/api/v1/characteristics/analyze', {
        method: 'POST', body: { waves }
      })
    } catch (e: any) {
      error.value = e.data?.detail || 'Analysis failed'
    } finally {
      loading.value = false
    }
  }

  return { result, loading, error, analyze }
}
