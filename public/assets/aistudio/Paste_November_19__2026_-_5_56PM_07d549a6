from app.schemas.complex_adv import ComplexRequest

def detect_nonstandard(req: ComplexRequest) -> tuple[str, str, bool]:
    """Detect non-standard (3+ patterns)."""
    if len(req.components) < 3:
        return "", "low", True
    
    parts = []
    for i, comp in enumerate(req.components):
        parts.append(comp.abbreviation)
        if i < len(req.components) - 1:
            parts.append("X")
    
    pattern_str = "-".join(parts)
    
    if len(req.components) <= 3:
        complexity = "medium"
    elif len(req.components) <= 4:
        complexity = "high"
    else:
        complexity = "too_complex"
    
    return pattern_str, complexity, False
