from app.schemas.rules import Wave, AbsoluteBottomResponse

def check_absolute_bottom(waves: list[Wave]) -> AbsoluteBottomResponse:
    """Check if absolute bottom has formed (wave 2 hasn't retraced 100% of wave 1)."""
    wave_map = {w.label: w for w in waves}
    
    if "1" not in wave_map or "2" not in wave_map:
        return AbsoluteBottomResponse(
            formed=False,
            reason="Insufficient data (need at least waves 1 and 2)"
        )
    
    w1 = wave_map["1"]
    w2 = wave_map["2"]
    
    if w1.direction == "up":
        retracement = (w1.end_price - w2.end_price) / w1.length
    else:
        retracement = (w2.end_price - w1.end_price) / w1.length
    
    if retracement >= 1.0:
        return AbsoluteBottomResponse(
            formed=False,
            reason=f"Wave 2 retraced {retracement*100:.1f}% of wave 1 (>=100%); absolute bottom not yet formed"
        )
    
    # Check if a complete cycle exists (for valid low)
    valid_low = all(label in wave_map for label in ["1","2","3","4","5","A","B","C"])
    
    return AbsoluteBottomResponse(
        formed=True,
        reason="Absolute bottom formed (wave 2 retraced <100% of wave 1)",
        valid_low_formed=valid_low
    )
