export const useNonIdealEngine = () => {
  const terminal = ref<NonIdealResponse | null>(null)
  const antiCycle = ref<NonIdealResponse | null>(null)
  const wave5 = ref<Wave5TerminalResponse | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)

  const detectTerminal = async (waves: Wave[], isMarketEnd = false) => {
    loading.value = true
    error.value = null
    try {
      terminal.value = await $fetch<NonIdealResponse>(
        '/api/v1/non-ideal/terminal',
        { method: 'POST', body: { waves, is_market_end: isMarketEnd } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Terminal detection failed'
    } finally {
      loading.value = false
    }
  }

  const detectAntiCycle = async (waves: Wave[], position: string, isMarketEnd = false) => {
    loading.value = true
    error.value = null
    try {
      antiCycle.value = await $fetch<NonIdealResponse>(
        `/api/v1/non-ideal/anti-cycle?position=${position}`,
        { method: 'POST', body: { waves, is_market_end: isMarketEnd } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Anti-Cycle detection failed'
    } finally {
      loading.value = false
    }
  }

  const detectWave5 = async (waves: Wave[]) => {
    try {
      wave5.value = await $fetch<Wave5TerminalResponse>(
        '/api/v1/non-ideal/wave5-terminal',
        { method: 'POST', body: { waves } }
      )
    } catch (e: any) {
      error.value = e.data?.detail || 'Wave 5 detection failed'
    }
  }

  return { terminal, antiCycle, wave5, loading, error, detectTerminal, detectAntiCycle, detectWave5 }
}
