from app.schemas.complex_adv import ComplexRequest, ComplexResponse
from app.services.detect_standard_service import detect_standard
from app.services.detect_nonstd_service import detect_nonstandard
from app.services.x_wave_service import classify_x_wave
from app.services.recommend_service import recommend_counting

def analyze_advanced_complex(req: ComplexRequest) -> ComplexResponse:
    notes = []
    warnings = []
    
    # Step 1: Detect standard or non-standard
    if len(req.components) == 2:
        pattern, standard = detect_standard(req)
        complexity = "low"
    else:
        pattern, complexity, standard = detect_nonstandard(req)
    
    if complexity == "too_complex":
        return ComplexResponse(
            pattern=pattern, standard=False, complexity=complexity,
            recommend="recount", confidence=0.2,
            warnings=["Too many patterns; recount recommended"]
        )
    
    notes.append(f"Pattern: {pattern}")
    notes.append(f"Standard: {standard}")
    
    # Step 2: X-Wave types
    x_types = [classify_x_wave(x) for x in req.x_waves]
    notes.append(f"X-Wave types: {x_types}")
    
    # Step 3: Recommendation
    recommend, rec_msg = recommend_counting(req)
    notes.append(rec_msg)
    
    # Step 4: Confidence
    confidence = 0.7 if standard else 0.5
    if complexity == "high":
        confidence -= 0.15
        warnings.append("High complexity; verify count")
    if req.is_market_end:
        confidence -= 0.2
        warnings.append("At market end; complex patterns less reliable")
    
    return ComplexResponse(
        pattern=pattern,
        standard=standard,
        complexity=complexity,
        x_types=x_types,
        recommend=recommend,
        confidence=max(0.0, min(1.0, confidence)),
        warnings=warnings,
        notes=notes
    )
