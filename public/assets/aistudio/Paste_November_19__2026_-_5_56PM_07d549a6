from pydantic import BaseModel, Field
from typing import Literal, Optional

class Wave(BaseModel):
    label: str  # "A", "B", "C", "D", "E"
    start_price: float
    end_price: float
    sub_wave_count: int = 3

    @property
    def length(self) -> float:
        return abs(self.end_price - self.start_price)

class TriangleRequest(BaseModel):
    waves: list[Wave]  # Must be 5 waves A-E
    position: Literal["1", "2", "3", "4", "5", "A", "B", "C"] = "4"
    main_trend: Literal["up", "down"] = "up"
    breakout_direction: Optional[Literal["up", "down"]] = None

class TriangleResponse(BaseModel):
    detected: bool
    type: Optional[Literal["Contracting", "Expanding"]] = None
    position_valid: bool = False
    continuation: Optional[Literal["up", "down", "reversal"]] = None
    naming_valid: bool = True
    frequency: Optional[str] = None  # "20%", "50%", "30%"
    confidence: float = Field(ge=0, le=1)
    warnings: list[str] = []
    notes: list[str] = []
