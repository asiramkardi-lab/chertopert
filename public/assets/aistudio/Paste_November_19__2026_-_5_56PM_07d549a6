const typeColor = computed(() => {
  const t = props.result?.type
  if (t === 'Regular') return 'success'
  if (t?.includes('Irregular')) return 'warning'
  if (t?.includes('Deficient')) return 'info'
  if (t === 'Running') return 'error'
  return 'neutral'
})

const typeDescription = computed(() => {
  const descriptions: Record<string, string> = {
    'Regular': 'B ≈ A, C ≈ B (most common)',
    'B-Deficient': 'B < 81% A (B short)',
    'C-Deficient': 'C < 81% B (C short)',
    'Double-Deficient': 'Both B and C deficient (high risk)',
    'Irregular': 'B > A (rare)',
    'Irregular-Deficient': 'B > A, C < B',
    'Irregular-Extended': 'B > 138.2% A, C > B',
    'Running': 'B > A, C very short (rarest)'
  }
  return descriptions[props.result?.type ?? ''] ?? ''
})
</script>
