from app.schemas.non_ideal import Wave, NonIdealResponse

def detect_terminal(waves: list[Wave], tolerance: float = 0.01) -> NonIdealResponse:
    """Detect Terminal or Anti-Terminal pattern."""
    wave_map = {w.label: w for w in waves}
    notes = []
    
    if not all(label in wave_map for label in ["1", "3", "4", "5"]):
        return NonIdealResponse(valid=False, notes=["Missing waves"])
    
    w1 = wave_map["1"]
    w3 = wave_map["3"]
    w4 = wave_map["4"]
    w5 = wave_map["5"]
    
    # Check Rule 3 violation: wave 4 overlaps wave 1
    if w1.direction == "up":
        w1_high = max(w1.start_price, w1.end_price)
        w4_low = min(w4.start_price, w4.end_price)
        rule3_violated = w4_low < w1_high
    else:
        w1_low = min(w1.start_price, w1.end_price)
        w4_high = max(w4.start_price, w4.end_price)
        rule3_violated = w4_high > w1_low
    
    if not rule3_violated:
        return NonIdealResponse(valid=False, notes=["Rule 3 not violated; not a terminal"])
    
    # Check wave 5 coverage of wave 4 (CB-Wave rule: must be >= 100%)
    if w5.direction == "up":
        w4_high = max(w4.start_price, w4.end_price)
        coverage = (w5.end_price - w4_high) / w4.length if w4.length > 0 else 0
    else:
        w4_low = min(w4.start_price, w4.end_price)
        coverage = (w4_low - w5.end_price) / w4.length if w4.length > 0 else 0
    
    if coverage < 1.0 - tolerance:
        return NonIdealResponse(
            valid=False,
            violations=[{"rule": "CB-Wave", "description": f"Wave 5 covers only {coverage*100:.1f}% of wave 4"}],
            notes=["Invalid terminal: wave 5 must cover 100% of wave 4"]
        )
    
    # Determine Terminal vs Anti-Terminal
    w5_len = w5.length
    w3_len = w3.length
    
    if w5_len < w3_len:
        # Terminal: wave 5 truncated
        return NonIdealResponse(
            pattern="Terminal",
            valid=True,
            wave_5_reaches_tmv=False,
            wave_5_coverage_of_wave_4=coverage,
            notes=["Terminal detected: Rule 3 violated, wave 5 truncated"]
        )
    else:
        # Anti-Terminal: wave 5 extended, wave 3 short
        if w3_len <= min(w1.length, w5_len):
            return NonIdealResponse(
                valid=False,
                violations=[{"rule": 2, "description": "Wave 3 is shortest in anti-terminal"}],
                notes=["Invalid anti-terminal: Rule 2 violated"]
            )
        
        return NonIdealResponse(
            pattern="Anti-Terminal",
            valid=True,
            wave_5_reaches_tmv=True,
            wave_5_coverage_of_wave_4=coverage,
            notes=["Anti-Terminal detected: Rule 3 violated, wave 5 extended, wave 3 short"]
        )
