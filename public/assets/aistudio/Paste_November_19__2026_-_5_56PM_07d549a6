from fastapi import APIRouter, HTTPException
from app.schemas.recognition import (
    RecognitionRequest, RecognitionResponse,
    BottomRequest, BottomResponse,
    StepRequest, StepResponse
)
from app.services.candle_service import validate_minimum_candles
from app.services.bottom_service import detect_absolute_bottom
from app.services.step_service import step_count

router = APIRouter(prefix="/api/v1/recognize", tags=["recognition"])

@router.post("/validate-wave", response_model=RecognitionResponse)
async def validate_wave_endpoint(req: RecognitionRequest):
    if len(req.candles) < 1:
        raise HTTPException(400, "No candles provided")
    direction = "up" if req.candles[-1].close > req.candles[0].close else "down"
    return validate_minimum_candles(req.candles, direction)

@router.post("/bottom", response_model=BottomResponse)
async def bottom_endpoint(req: BottomRequest):
    if len(req.candles) < 10:
        raise HTTPException(400, "Insufficient candles (minimum 10)")
    return detect_absolute_bottom(req.candles)

@router.post("/step-count", response_model=StepResponse)
async def step_count_endpoint(req: StepRequest):
    if len(req.candles) < 20:
        raise HTTPException(400, "Insufficient candles (minimum 20)")
    return step_count(req)
