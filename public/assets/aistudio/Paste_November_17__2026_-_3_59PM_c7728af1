def refine_to_lower_timeframe(
    candles_high_tf: list[Candle],
    candles_low_tf: list[Candle],
    cycles_high_tf: list[Cycle]
) -> list[Cycle]:
    """پالایش سیکل‌ها با تایم‌فریم پایین‌تر."""
    refined = []
    
    for high_cycle in cycles_high_tf:
        # برای هر موج اصلی در سیکل بالا، ساختار درونی را در تایم پایین بررسی کن
        for wave in high_cycle.main_waves:  # 1, 3, 5, A, C
            internal = detect_internal_structure(
                candles_low_tf, wave.start_idx, wave.end_idx
            )
            
            if internal is None:
                # شتابدار → فرض ۵ موجی
                wave.is_impulsive = True
                wave.internal_structure = 5
            elif internal.count == 5:
                wave.internal_structure = 5
                wave.sub_waves = internal.waves
            elif internal.count == 3:
                # نقض ساختار (موج اصلی با ۳ موج)
                wave.warning = f"Wave {wave.label} has 3 sub-waves; possible mislabel"
                # بررسی الگوی جایگزین
                if validate_diagonal_internal(internal).valid:
                    wave.pattern = "diagonal"
                else:
                    wave.valid = False
        
        if high_cycle.valid:
            refined.append(high_cycle)
    
    return refined
