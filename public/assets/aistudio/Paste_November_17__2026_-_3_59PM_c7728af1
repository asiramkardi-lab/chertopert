def coarse_wave_count(
    candles: list[Candle],
    bottom_idx: int,
    max_degree: int
) -> list[Cycle]:
    """درشت‌موج‌شماری از کف مطلق."""
    
    # ۳.۱.۱: پیدا کردن پیوت‌ها با window مناسب
    window = get_pivot_window(get_timeframe_from_candles(candles))
    pivots = find_pivots(candles[bottom_idx:], window)
    
    # ۳.۱.۲: بررسی حداقل پیوت
    if len(pivots) < 8:
        return []  # نمی‌توان سیکل کامل ساخت
    
    # ۳.۱.۳: ساخت کاندیدهای سیکل
    candidates = build_cycle_candidates(pivots, candles[bottom_idx:])
    
    # ۳.۱.۴: اعتبارسنجی هر کاندید با ترتیب اولویت
    valid_cycles = []
    for cand in candidates:
        result = validate_cycle_priority(cand)
        if result.valid or result.alternative:
            cand.confidence = result.confidence
            cand.type = result.type
            valid_cycles.append(cand)
    
    # ۳.۱.۵: انتخاب بهترین کاندید (بیشترین confidence)
    valid_cycles.sort(key=lambda c: c.confidence, reverse=True)
    
    # ۳.۱.۶: برگرداندن تا ۳ کاندید برتر (برای سناریو بندی)
    return valid_cycles[:3]
