def validate_input_data(candles_by_tf: dict[str, list[Candle]]) -> ValidationResult:
    """اعتبارسنجی کامل داده ورودی."""
    errors = []
    warnings = []
    
    # ۰.۱.۱: بررسی وجود تایم‌فریم روزانه (حداقل)
    if "daily" not in candles_by_tf:
        errors.append("Missing daily timeframe data")
        return ValidationResult(valid=False, errors=errors)
    
    daily = candles_by_tf["daily"]
    
    # ۰.۱.۲: بررسی خالی نبودن
    if len(daily) == 0:
        errors.append("Empty data")
        return ValidationResult(valid=False, errors=errors)
    
    # ۰.۱.۳: بررسی حداقل ۱۰ کندل
    if len(daily) < 10:
        errors.append(f"Insufficient data: {len(daily)} candles (min 10)")
        return ValidationResult(valid=False, errors=errors)
    
    # ۰.۱.۴: بررسی NaN
    nan_count = sum(1 for c in daily if any(
        pd.isna(c.open) or pd.isna(c.high) or pd.isna(c.low) or pd.isna(c.close)
        for _ in [1]
    ))
    if nan_count > 0:
        if nan_count > len(daily) * 0.1:  # بیش از ۱۰٪ NaN
            errors.append(f"Too many NaN values: {nan_count}")
        else:
            warnings.append(f"Forward-filled {nan_count} NaN values")
    
    # ۰.۱.۵: بررسی timestamp تکراری
    timestamps = [c.timestamp for c in daily]
    if len(timestamps) != len(set(timestamps)):
        errors.append("Duplicate timestamps found")
    
    # ۰.۱.۶: بررسی ترتیب زمانی
    for i in range(1, len(daily)):
        if daily[i].timestamp < daily[i-1].timestamp:
            errors.append(f"Timestamp out of order at index {i}")
            break
    
    # ۰.۱.۷: بررسی نوسان قیمت (همه یکسان)
    all_prices = [c.close for c in daily]
    if len(set(all_prices)) == 1:
        errors.append("No price movement (all closes identical)")
    
    # ۰.۱.۸: بررسی کندل‌های Doji (همه open=high=low=close)
    doji_count = sum(1 for c in daily if c.open == c.high == c.low == c.close)
    if doji_count == len(daily):
        errors.append("All candles are Doji (no price movement)")
    elif doji_count > len(daily) * 0.5:
        warnings.append(f"High Doji count: {doji_count}")
    
    # ۰.۱.۹: بررسی کندل‌های با قیمت منفی
    if any(c.low < 0 for c in daily):
        errors.append("Negative prices found")
    
    # ۰.۱.۱۰: بررسی high < low
    if any(c.high < c.low for c in daily):
        errors.append("Invalid candle: high < low")
    
    return ValidationResult(
        valid=len(errors) == 0,
        errors=errors,
        warnings=warnings
    )
