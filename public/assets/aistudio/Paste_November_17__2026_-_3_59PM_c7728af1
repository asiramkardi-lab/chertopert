def detect_internal_structure(
    candles: list[Candle],
    start_idx: int,
    end_idx: int
) -> InternalStructure | None:
    """تشخیص ساختار درونی یک موج در تایم پایین‌تر."""
    segment = candles[start_idx:end_idx+1]
    
    if len(segment) < 10:
        return None  # دیتای ناکافی
    
    # پیدا کردن پیوت‌های داخلی
    pivots = find_pivots(segment, window=3)
    
    if len(pivots) < 4:
        return None  # نمی‌توان ساختار ۳ موجی ساخت
    
    # بررسی ساختار ۵ موجی (۶ پیوت)
    if len(pivots) >= 6:
        if is_alternating(pivots[:6]):
            return InternalStructure(count=5, waves=pivots_to_waves(pivots[:6]))
    
    # بررسی ساختار ۳ موجی (۴ پیوت)
    if len(pivots) >= 4:
        if is_alternating(pivots[:4]):
            return InternalStructure(count=3, waves=pivots_to_waves(pivots[:4]))
    
    return None
