def full_wave_counting_pipeline(
    candles_by_tf: dict[str, list[Candle]],
    market: str = "stock"
) -> WaveCountingResult:
    """خط لوله کامل موج‌شماری از بالا به پایین."""
    
    # ═══════════════════════════════════════════════════════
    # گام ۰: اعتبارسنجی داده
    # ═══════════════════════════════════════════════════════
    validation = validate_input_data(candles_by_tf)
    if not validation.valid:
        return WaveCountingResult(
            error="; ".join(validation.errors),
            warnings=validation.warnings
        )
    
    # ═══════════════════════════════════════════════════════
    # گام ۱: انتخاب تایم‌فریم شروع و حداکثر درجه
    # ═══════════════════════════════════════════════════════
    start_tf = select_start_timeframe(candles_by_tf["daily"])
    
    # اگر تایم شروع در دیکشنری نیست، به تایم پایین‌تر برو
    while start_tf not in candles_by_tf and start_tf != "daily":
        start_tf = get_next_timeframe(start_tf)
    
    max_degree = get_max_degree(start_tf, market)
    
    # ═══════════════════════════════════════════════════════
    # گام ۲: پیدا کردن کف مطلق
    # ═══════════════════════════════════════════════════════
    bottom_idx = find_absolute_bottom(candles_by_tf[start_tf])
    if bottom_idx is None:
        return WaveCountingResult(error="No absolute bottom found")
    
    bottom_valid, bottom_msg = validate_absolute_bottom(
        candles_by_tf[start_tf], bottom_idx
    )
    if not bottom_valid:
        return WaveCountingResult(error=bottom_msg)
    
    # ═══════════════════════════════════════════════════════
    # گام ۳: درشت‌موج‌شماری
    # ═══════════════════════════════════════════════════════
    cycles = coarse_wave_count(
        candles_by_tf[start_tf], bottom_idx, max_degree
    )
    if not cycles:
        return WaveCountingResult(error="No valid cycles found")
    
    # ═══════════════════════════════════════════════════════
    # گام ۴-۵: پالایش تکراری
    # ═══════════════════════════════════════════════════════
    current_tf = start_tf
    current_degree = 1
    
    while current_degree < max_degree:
        next_tf = get_next_timeframe(current_tf)
        if next_tf is None or next_tf not in candles_by_tf:
            break
        
        if len(candles_by_tf[next_tf]) < 10:
            break
        
        cycles = refine_to_lower_timeframe(
            candles_by_tf[current_tf],
            candles_by_tf[next_tf],
            cycles
        )
        
        if not cycles:
            return WaveCountingResult(error="Refinement failed")
        
        current_tf = next_tf
        current_degree += 1
    
    # ═══════════════════════════════════════════════════════
    # گام ۶: توقف در درجه مجاز
    # ═══════════════════════════════════════════════════════
    if current_degree >= max_degree:
        cycles = promote_degrees(cycles)
    
    # ═══════════════════════════════════════════════════════
    # گام ۷: اعتبارسنجی نهایی
    # ═══════════════════════════════════════════════════════
    validation_report = final_validation(cycles, {
        "market": market,
        "timeframe": current_tf,
        "degree": current_degree
    })
    
    # ═══════════════════════════════════════════════════════
    # گام ۸: سناریو بندی
    # ═══════════════════════════════════════════════════════
    scenarios = generate_scenarios(cycles)
    
    # ═══════════════════════════════════════════════════════
    # گام ۹: PRZ و TMV
    # ═══════════════════════════════════════════════════════
    prz_list = []
    tmv = None
    
    for wave in cycles[0].corrective_waves:
        for level in [0.382, 0.5, 0.618, 0.786]:
            prz_list.append(compute_prz(wave, level))
    
    if len(cycles[0].waves) >= 2:
        tmv = compute_tmv(cycles[0].wave_1, cycles[0].wave_2)
    
    # ═══════════════════════════════════════════════════════
    # گام ۱۰: توصیه ورود
    # ═══════════════════════════════════════════════════════
    entry = recommend_entry(cycles, scenarios)
    
    # ═══════════════════════════════════════════════════════
    # گام ۱۱: مدیریت ریسک
    # ═══════════════════════════════════════════════════════
    current_price = candles_by_tf[current_tf][-1].close
    stop = None
    
    if entry.entry_price and tmv:
        extension = cycles[0].wave_5.extension if cycles[0].wave_5 else None
        pattern_type = cycles[0].type
        stop = update_trailing_stop(
            current_price=current_price,
            entry_price=entry.entry_price,
            tmv=tmv,
            extension=extension,
            pattern_type=pattern_type
        )
    
    # ═══════════════════════════════════════════════════════
    # خروجی نهایی
    # ═══════════════════════════════════════════════════════
    return WaveCountingResult(
        cycles=cycles,
        validation=validation_report,
        scenarios=scenarios,
        prz=prz_list,
        tmv=tmv,
        entry=entry,
        stop=stop,
        bottom_idx=bottom_idx,
        start_tf=start_tf,
        final_tf=current_tf,
        final_degree=current_degree,
        warnings=validation.warnings
    )
