def coarse_wave_count(
    candles: list[Candle],
    bottom_idx: int,
    max_degree: int
) -> list[Wave]:
    """درشت‌موج‌شماری از کف مطلق تا کف معتبر."""
    # ۱. پیدا کردن پیوت‌ها
    pivots = find_pivots(candles[bottom_idx:], window=5)
    
    # ۲. ساخت کاندیدهای سیکل
    candidates = build_cycle_candidates(pivots, candles[bottom_idx:])
    
    # ۳. اعتبارسنجی هر کاندید
    valid_cycles = []
    for cand in candidates:
        result = validate_cycle(cand)
        if result.valid or result.alternative:
            valid_cycles.append(cand)
    
    # ۴. انتخاب بهترین کاندید (بیشترین confidence)
    best = max(valid_cycles, key=lambda c: c.confidence, default=None)
    
    return best
