def select_start_timeframe(candles: list[Candle]) -> str:
    """انتخاب تایم‌فریم شروع بر اساس طول داده."""
    days = (candles[-1].timestamp - candles[0].timestamp).days
    
    if days < 180:  # < 6 ماه
        return "daily"  # کف مطلق در روزانه قابل تشخیص است
    elif days < 365:  # 6 ماه - 1 سال
        return "weekly"  # از هفتگی شروع کن
    elif days < 365 * 5:  # 1-5 سال
        return "weekly"  # از هفتگی شروع کن
    else:  # > 5 سال
        return "monthly"  # از ماهانه شروع کن
