def compute_tmv(wave1: Wave, wave2: Wave) -> TMV:
    """محاسبه هدف حرکت موج ۳."""
    x = wave1.start_price
    y = wave1.end_price
    z = wave2.end_price
    
    direction = "up" if y > x else "down"
    sign = 1 if direction == "up" else -1
    length = abs(y - x)
    
    return TMV(
        prime=y,
        ideal=z + sign * length * 1.0,
        alternate=z + sign * length * 1.618,
        direction=direction
    )

def compute_tmv_short(wave: Wave) -> float:
    """TMV کوتاه (هدف اولیه)."""
    return wave.end_price

def compute_tmv_ideal(wave1: Wave, wave2: Wave) -> float:
    """TMV ایده‌آل (۱۰۰٪ پروجکشن)."""
    length = wave1.length
    if wave1.direction == "up":
        return wave2.end_price + length * 1.0
    else:
        return wave2.end_price - length * 1.0

def compute_tmv_alternate(wave1: Wave, wave2: Wave) -> float:
    """TMV جایگزین (۱۶۱.۸٪ پروجکشن)."""
    length = wave1.length
    if wave1.direction == "up":
        return wave2.end_price + length * 1.618
    else:
        return wave2.end_price - length * 1.618
