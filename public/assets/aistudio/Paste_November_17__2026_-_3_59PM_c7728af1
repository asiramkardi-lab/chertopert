def iterative_refinement(
    candles_by_tf: dict[str, list[Candle]],
    cycles: list[Cycle],
    current_tf: str,
    max_degree: int
) -> list[Cycle]:
    """پالایش تکراری تا رسیدن به max_degree."""
    current_degree = get_degree_from_tf(current_tf)
    
    # ۵.۱.۱: بررسی توقف
    if current_degree >= max_degree:
        return cycles
    
    # ۵.۱.۲: تایم بعدی
    next_tf = get_next_timeframe(current_tf)
    if next_tf is None or next_tf not in candles_by_tf:
        return cycles  # توقف
    
    # ۵.۱.۳: بررسی حداقل دیتا در تایم بعدی
    if len(candles_by_tf[next_tf]) < 10:
        return cycles  # دیتای ناکافی
    
    # ۵.۱.۴: پالایش
    refined = refine_to_lower_timeframe(
        candles_by_tf[current_tf],
        candles_by_tf[next_tf],
        cycles
    )
    
    # ۵.۱.۵: بازگشت تکراری
    return iterative_refinement(
        candles_by_tf, refined, next_tf, max_degree
    )
