def promote_degrees(cycles: list[Cycle]) -> list[Cycle]:
    """ارتقاء لیبل‌ها وقتی درجه ۴ تمام شود."""
    for cycle in cycles:
        for wave in cycle.waves:
            current_idx = DEGREE_ORDER.index(wave.degree)
            new_idx = min(current_idx + 1, len(DEGREE_ORDER) - 1)
            wave.degree = DEGREE_ORDER[new_idx]
    return cycles
