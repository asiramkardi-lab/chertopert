def update_trailing_stop(
    current_price: float,
    entry_price: float,
    tmv: TMV,
    extension: str | None,
    pattern_type: str
) -> StopRecommendation:
    """به‌روزرسانی استاپ بر اساس TMV hit."""
    
    # ۱۱.۱.۱: کشیدگی موج ۵ → سیو سود فوری
    if extension == "wave_5":
        return StopRecommendation(
            action="immediate_profit_taking",
            stop_price=current_price,
            reason="Wave 5 extension: reversal imminent"
        )
    
    # ۱۱.۱.۲: ترمینال → سیو سود
    if pattern_type == "terminal":
        return StopRecommendation(
            action="profit_taking",
            stop_price=current_price * 0.98,
            reason="Terminal pattern: wave 5 truncated"
        )
    
    # ۱۱.۱.۳: قطر پایانی → سیو سود
    if pattern_type == "ending_diagonal":
        return StopRecommendation(
            action="profit_taking",
            stop_price=current_price * 0.97,
            reason="Ending diagonal: reversal imminent"
        )
    
    # ۱۱.۱.۴: TMV Alternate hit
    if current_price >= tmv.alternate:
        return StopRecommendation(
            action="trail_high",
            stop_price=current_price * 0.95,
            reason="Alternate hit; lock 5% profit"
        )
    
    # ۱۱.۱.۵: TMV Ideal hit
    if current_price >= tmv.ideal:
        return StopRecommendation(
            action="trail_mid",
            stop_price=current_price * 0.93,
            reason="Ideal hit; lock 7% profit"
        )
    
    # ۱۱.۱.۶: TMV Prime hit
    if current_price >= tmv.prime:
        return StopRecommendation(
            action="trail_low",
            stop_price=current_price * 0.90,
            reason="Prime hit; lock 10% profit"
        )
    
    # ۱۱.۱.۷: بدون hit
    return StopRecommendation(
        action="initial_stop",
        stop_price=entry_price * 0.95,
        reason="No TMV hit yet; initial stop"
    )
