def find_absolute_bottom(candles: list[Candle]) -> int | None:
    """پیدا کردن پایین‌ترین نقطه در کل نمودار."""
    if not candles:
        return None
    
    lowest_idx = min(range(len(candles)), key=lambda i: candles[i].low)
    return lowest_idx
