        cycle_valid = True
        
        for wave in cycle.main_waves:  # 1, 3, 5, A, C
            # ۴.۱.۱: بررسی ساختار درونی در تایم پایین
            internal = detect_internal_structure(
                candles_low_tf, wave.start_idx, wave.end_idx
            )
            
            # ۴.۱.۲: اگر ساختار قابل شمارش نیست → شتابدار
            if internal is None:
                wave.is_impulsive = True
                wave.internal_structure = 5  # فرض ۵ موجی
                wave.warning = "Impulsive; assuming 5 sub-waves"
                continue
            
            # ۴.۱.۳: اگر ساختار ۵ موجی → فرکتالی
            if internal.count == 5:
                wave.internal_structure = 5
                wave.sub_waves = internal.waves
                wave.is_impulsive = False
                continue
            
            # ۴.۱.۴: اگر ساختار ۳ موجی → نقض ساختار
            if internal.count == 3:
                # بررسی: آیا الگوی قطر است؟
                if validate_diagonal_internal(internal).valid:
                    wave.pattern = "diagonal"
                    wave.internal_structure = 3
                else:
                    wave.warning = f"Wave {wave.label} has 3 sub-waves; possible mislabel"
                    cycle_valid = False
        
        # ۴.۱.۵: بررسی امواج اصلاحی
        for wave in cycle.corrective_waves:  # 2, 4, B
            internal = detect_internal_structure(
                candles_low_tf, wave.start_idx, wave.end_idx
            )
            
            if internal is None:
                wave.is_impulsive = True
                wave.internal_structure = 3  # فرض ۳ موجی
                continue
            
            if internal.count == 3:
                wave.internal_structure = 3
                wave.sub_waves = internal.waves
                continue
            
            if internal.count == 5:
                # آنتی‌سیکل یا ترکیبی
                if validate_anti_cycle_internal(internal).valid:
                    wave.pattern = "anti_cycle"
                else:
                    wave.pattern = "complex"
                wave.internal_structure = 5
        
        if cycle_valid:
            refined.append(cycle)
    
    return refined
