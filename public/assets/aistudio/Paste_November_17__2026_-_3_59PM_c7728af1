def validate_cycle_priority(cycle: Cycle) -> ValidationResult:
    """اعتبارسنجی سیکل با ترتیب اولویت (از جلسه ۱۶)."""
    waves = cycle.to_waves()
    
    # اولویت ۱: سیکل ایده‌آل
    if cycle.type == "ideal":
        result = validate_ideal_cycle(waves)
        if result.valid:
            return ValidationResult(valid=True, type="ideal", confidence=0.95)
    
    # اولویت ۲: الگوی قطر
    if cycle.type == "diagonal":
        result = validate_diagonal(waves)
        if result.valid:
            return ValidationResult(valid=True, type="diagonal", confidence=0.85)
    
    # اولویت ۳: ترمینال / آنتی‌سیکل
    if cycle.type == "terminal":
        result = validate_terminal(waves)
        if result.valid:
            return ValidationResult(valid=True, type="terminal", confidence=0.8)
    
    if cycle.type == "anti_cycle":
        result = validate_anti_cycle(waves)
        if result.valid:
            return ValidationResult(valid=True, type="anti_cycle", confidence=0.75)
    
    # اولویت ۴: زیگزاگ
    if cycle.type == "zigzag":
        result = validate_zigzag(waves)
        if result.valid:
            return ValidationResult(valid=True, type="zigzag", confidence=0.7)
    
    # اولویت ۵: فلت
    if cycle.type == "flat":
        result = validate_flat(waves)
        if result.valid:
            return ValidationResult(valid=True, type="flat", confidence=0.65)
    
    # اولویت ۶: مثلث
    if cycle.type == "triangle":
        result = validate_triangle(waves)
        if result.valid:
            return ValidationResult(valid=True, type="triangle", confidence=0.7)
    
    # اولویت ۷: ترکیبی (آخرین راه‌حل)
    result = validate_complex(waves)
    if result.valid:
        return ValidationResult(valid=True, type="complex", confidence=0.5)
    
    return ValidationResult(valid=False, reason="No valid pattern")
