def recommend_entry(cycles: list[Cycle], scenarios: list[Scenario]) -> EntryRecommendation:
    """توصیه ورود بر اساس سناریوها."""
    primary = max(scenarios, key=lambda s: s.probability)
    
    if primary.name == "uptrend_continuation":
        # ورود در شروع موج ۳
        return EntryRecommendation(
            action="buy",
            zone="start_wave_3",
            entry_price=cycles[-1].wave_2.end_price,
            stop_loss=cycles[-1].wave_2.end_price * 0.98,
            targets=[
                cycles[-1].tmv.prime,
                cycles[-1].tmv.ideal,
                cycles[-1].tmv.alternate
            ],
            risk="low"
        )
    
    elif primary.name == "downtrend_start":
        return EntryRecommendation(
            action="sell",
            zone="start_wave_A",
            entry_price=cycles[-1].wave_5.end_price,
            stop_loss=cycles[-1].wave_5.end_price * 1.02,
            targets=[
                cycles[-1].wave_4.start_price,
                cycles[-1].wave_3.end_price
            ],
            risk="medium"
        )
    
    else:  # range_bound
        return EntryRecommendation(
            action="wait",
            zone="none",
            entry_price=None,
            stop_loss=None,
            targets=[],
            risk="high"
        )
