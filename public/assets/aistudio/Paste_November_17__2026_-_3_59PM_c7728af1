def compute_prz(wave: Wave, fib_level: float) -> PRZ:
    """محاسبه محدوده پرپتانسیل چرخش."""
    if wave.direction == "up":
        start = wave.end_price - wave.length * fib_level
        end = wave.end_price - wave.length * (fib_level - 0.05)
    else:
        start = wave.end_price + wave.length * (fib_level - 0.05)
        end = wave.end_price + wave.length * fib_level
    
    return PRZ(
        start=start, end=end,
        level=fib_level,
        confidence=get_prz_confidence(fib_level)
    )
۸.۲ محاسبه TMV
