def validate_absolute_bottom(candles: list[Candle], bottom_idx: int) -> tuple[bool, str]:
    """بررسی اینکه کف مطلق واقعاً تشکیل شده."""
    if bottom_idx is None or bottom_idx == 0:
        return False, "No data before bottom; cannot validate"
    
    # بررسی: آیا کندل‌های قبل از کف مطلق وجود دارند؟
    # اگر کف مطلق در ابتدای نمودار است، ممکن است کف واقعی نباشد
    if bottom_idx < 5:
        return False, "Bottom too close to start; possible incomplete data"
    
    # بررسی: آیا قیمت بعد از کف مطلق، ۱۰۰٪ آن را پوشش داده؟
    post_bottom = candles[bottom_idx:]
    if len(post_bottom) > 20:
        # اگر قیمت به کف مطلق برگشته و آن را شکسته → کف مطلق جدید
        if min(c.low for c in post_bottom[10:]) < candles[bottom_idx].low:
            return False, "Bottom broken; new bottom formed"
    
    return True, f"Absolute bottom at index {bottom_idx} (low={candles[bottom_idx].low})"
