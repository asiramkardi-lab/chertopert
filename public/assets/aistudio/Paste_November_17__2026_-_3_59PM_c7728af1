def get_pivot_window(timeframe: str) -> int:
    """انتخاب window مناسب برای هر تایم‌فریم."""
    windows = {
        "monthly": 3,
        "weekly": 4,
        "daily": 5,
        "4h": 6,
        "1h": 8,
        "15m": 10,
    }
    return windows.get(timeframe, 5)

def find_pivots(candles: list[Candle], window: int = 5) -> list[Pivot]:
    """پیدا کردن پیوت‌های high/low."""
    pivots = []
    for i in range(window, len(candles) - window):
        # High pivot
        if candles[i].high == max(c.high for c in candles[i-window:i+window+1]):
            pivots.append(Pivot(index=i, type="high", price=candles[i].high))
        # Low pivot
        if candles[i].low == min(c.low for c in candles[i-window:i+window+1]):
            pivots.append(Pivot(index=i, type="low", price=candles[i].low))
    return pivots
