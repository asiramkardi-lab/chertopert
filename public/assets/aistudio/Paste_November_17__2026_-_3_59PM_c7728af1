def full_wave_counting_pipeline(
    candles_by_tf: dict[str, list[Candle]],
    market: str = "stock"
) -> WaveCountingResult:
    """خط لوله کامل موج‌شماری از بالا به پایین."""
    
    # گام ۰: اعتبارسنجی
    validation = validate_input_data(candles_by_tf)
    if not validation.valid:
        return WaveCountingResult(error=validation.error)
    
    start_tf = select_start_timeframe(candles_by_tf["daily"])
    max_degree = get_max_degree(start_tf, market)
    
    # گام ۱: کف مطلق
    bottom_idx = find_absolute_bottom(candles_by_tf[start_tf])
    if bottom_idx is None:
        return WaveCountingResult(error="No absolute bottom")
    
    bottom_valid, bottom_msg = validate_absolute_bottom(
        candles_by_tf[start_tf], bottom_idx
    )
    if not bottom_valid:
        return WaveCountingResult(error=bottom_msg)
    
    # گام ۲: درشت‌موج‌شماری
    cycles_v = coarse_wave_count(
        candles_by_tf[start_tf], bottom_idx, max_degree
    )
    if not cycles_v:
        return WaveCountingResult(error="No valid cycles found")
    
    # گام ۳-۴: پالایش تکراری
    current_tf = start_tf
    current_degree = 1
    cycles = cycles_v
    
    while current_degree < max_degree:
        next_tf = get_next_timeframe(current_tf)
        if next_tf not in candles_by_tf:
            break
        
        cycles = refine_to_lower_timeframe(
            candles_by_tf[current_tf],
            candles_by_tf[next_tf],
            cycles
        )
        
        current_tf = next_tf
        current_degree += 1
    
    # گام ۵: توقف
    if current_degree >= max_degree:
        cycles = promote_degrees(cycles)
    
    # گام ۶: اعتبارسنجی نهایی
    validation_report = final_validation(cycles, {
        "market": market,
        "timeframe": current_tf,
        "degree": current_degree
    })
    
    # گام ۷: سناریو بندی
    scenarios = generate_scenarios(cycles)
    
    # گام ۸: PRZ/TMV
    prz_list = [compute_prz(w, 0.618) for w in cycles[-1].corrective_waves]
    tmv = compute_tmv(cycles[-1].wave_1, cycles[-1].wave_2)
    
    # گام ۹: توصیه ورود
    entry = recommend_entry(cycles, scenarios)
    
    # گام ۱۰: مدیریت ریسک
    stop = update_trailing_stop(
        current_price=candles_by_tf[current_tf][-1].close,
        entry_price=entry.entry_price or 0,
        tmv=tmv,
        extension=cycles[-1].wave_5.extension
    )
    
    return WaveCountingResult(
        cycles=cycles,
        validation=validation_report,
        scenarios=scenarios,
        prz=prz_list,
        tmv=tmv,
        entry=entry,
        stop=stop,
        bottom_idx=bottom_idx,
        start_tf=start_tf,
        final_tf=current_tf,
        final_degree=current_degree
    )
نکات کلیدی برای LLM
ترتیب اولویت: همیشه از ساده‌ترین الگو شروع کن (ایده‌آل → قطر → ترمینال → زیگزاگ → فلت → مثلث → ترکیبی).

توقف در درجه ۴: در بورس، زیر درجه ۴ نشمار.

کف مطلق: اگر کف مطلق تشکیل نشده → شمارش نکن.

فرض ساختار: موج شتابدار → فرض ۵ (اصلی) یا ۳ (اصلاحی).

هم‌خوانی درجات: موج ۲ و ۴ باید اندازه مشابه داشته باشند (نسبت < ۱۰).

سناریو بندی: همیشه ۲-۳ سناریو ممکن در نظر بگیر.

PRZ و TMV: PRZ = محدوده چرخش؛ TMV = هدف حرکت.

ورود: رتریسمنت ≥ ۵۰٪ + سیگنال.

مدیریت ریسک: Trailing Stop بر اساس TMV hit.

Edge Cases: همه شرایط مرزی از سند قبلی را چک کن.

