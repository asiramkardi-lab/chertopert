def update_trailing_stop(
    current_price: float,
    entry_price: float,
    tmv: TMV,
    extension: str | None
) -> StopRecommendation:
    """به‌روزرسانی استاپ بر اساس TMV hit."""
    if extension == "wave_5":
        return StopRecommendation(
            action="immediate_profit_taking",
            stop_price=current_price,
            reason="Wave 5 extension: reversal imminent"
        )
    
    if current_price >= tmv.alternate:
        return StopRecommendation(
            action="trail_high",
            stop_price=current_price * 0.95,
            reason="Alternate hit; lock 5% profit"
        )
    elif current_price >= tmv.ideal:
        return StopRecommendation(
            action="trail_mid",
            stop_price=current_price * 0.93,
            reason="Ideal hit; lock 7% profit"
        )
    elif current_price >= tmv.prime:
        return StopRecommendation(
            action="trail_low",
            stop_price=current_price * 0.90,
            reason="Prime hit; lock 10% profit"
        )
    
    return StopRecommendation(
        action="initial_stop",
        stop_price=entry_price * 0.95,
        reason="No TMV hit yet; initial stop"
    )
