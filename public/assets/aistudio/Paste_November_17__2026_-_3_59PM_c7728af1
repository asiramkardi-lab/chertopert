def select_start_timeframe(daily_candles: list[Candle]) -> str:
    """انتخاب تایم‌فریم شروع بر اساس طول داده."""
    days = (daily_candles[-1].timestamp - daily_candles[0].timestamp).days
    
    # قانون: < ۶ ماه → daily
    if days < 180:
        return "daily"
    
    # قانون: ۶ ماه - ۵ سال → weekly
    elif days < 365 * 5:
        return "weekly"
    
    # قانون: > ۵ سال → monthly
    else:
        return "monthly"
