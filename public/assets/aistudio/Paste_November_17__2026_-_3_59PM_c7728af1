def build_cycle_candidates(pivots: list[Pivot], candles: list[Candle]) -> list[Cycle]:
    """ساخت کاندیدهای سیکل از پیوت‌ها."""
    candidates = []
    
    # ۳.۳.۱: سیکل ایده‌آل (۸ پیوت متناوب)
    for i in range(len(pivots) - 7):
        points = pivots[i:i+8]
        if is_alternating(points):
            candidates.append(Cycle(points=points, type="ideal"))
    
    # ۳.۳.۲: سیکل ترمینال (نقض قانون ۳ + موج ۵ کوتاه)
    for i in range(len(pivots) - 7):
        points = pivots[i:i+8]
        if is_alternating(points):
            waves = points_to_waves(points, candles)
            if violates_rule_3(waves) and waves[4].length < waves[2].length:
                candidates.append(Cycle(points=points, type="terminal"))
    
    # ۳.۳.۳: آنتی‌سیکل (نقض قانون ۱ + ساختار ۳-۵)
    for i in range(len(pivots) - 7):
        points = pivots[i:i+8]
        if is_alternating(points):
            waves = points_to_waves(points, candles)
            if violates_rule_1(waves) and waves[0].sub_wave_count == 3:
                candidates.append(Cycle(points=points, type="anti_cycle"))
    
    # ۳.۳.۴: الگوی قطر (ساختار ۳-۳-۳-۳-۳)
    for i in range(len(pivots) - 7):
        points = pivots[i:i+8]
        if is_alternating(points):
            waves = points_to_waves(points, candles)
            if all(w.sub_wave_count == 3 for w in waves[:5]):
                candidates.append(Cycle(points=points, type="diagonal"))
    
    # ۳.۳.۵: زیگزاگ (ساختار ۵-۳-۵)
    for i in range(len(pivots) - 3):
        points = pivots[i:i+4]
        if is_alternating(points):
            waves = points_to_waves(points, candles)
            if is_zigzag(waves):
                candidates.append(Cycle(points=points, type="zigzag"))
    
    # ۳.۳.۶: فلت (ساختار ۳-۳-۵)
    for i in range(len(pivots) - 3):
        points = pivots[i:i+4]
        if is_alternating(points):
            waves = points_to_waves(points, candles)
            if is_flat(waves):
                candidates.append(Cycle(points=points, type="flat"))
    
    # ۳.۳.۷: مثلث (ساختار ۳-۳-۳-۳-۳)
    for i in range(len(pivots) - 5):
        points = pivots[i:i+6]
        if is_alternating(points):
            waves = points_to_waves(points, candles)
            if is_triangle(waves):
                candidates.append(Cycle(points=points, type="triangle"))
    
    # ۳.۳.۸: ترکیبی (در صورت عدم موفقیت سایر الگوها)
    # (این در validate_cycle_priority بررسی می‌شود)
    
    return candidates
