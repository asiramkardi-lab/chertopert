def validate_absolute_bottom(
    candles: list[Candle],
    bottom_idx: int
) -> tuple[bool, str]:
    """بررسی اینکه کف مطلق واقعاً تشکیل شده."""
    
    # ۲.۲.۱: اگر کف در ابتدای نمودار است → ممکن است ناقص باشد
    if bottom_idx < 5:
        return False, "Bottom too close to start; possible incomplete data"
    
    # ۲.۲.۲: بررسی شکست کف توسط کندل‌های بعدی
    # اگر قیمت بعد از کف، به زیر کف برگشته → کف مطلق جدید
    post_bottom = candles[bottom_idx:]
    if len(post_bottom) > 20:
        # فقط ۱۰ کندل بعد از کف را بررسی کن (نه همه)
        # چون ممکن است سیکل بعدی کف جدید بسازد
        if min(c.low for c in post_bottom[10:20]) < candles[bottom_idx].low:
            return False, "Bottom broken by subsequent candles; new bottom formed"
    
    # ۲.۲.۳: بررسی اینکه کف مطلق قبل از کندل‌های کافی است
    if bottom_idx == 0:
        return False, "Bottom at index 0; no prior data for reference"
    
    return True, f"Absolute bottom at index {bottom_idx} (low={candles[bottom_idx].low})"
