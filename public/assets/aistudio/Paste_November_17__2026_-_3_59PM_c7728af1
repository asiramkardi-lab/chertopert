def iterative_refinement(
    candles_by_tf: dict[str, list[Candle]],
    cycles: list[Cycle],
    current_degree: int,
    max_degree: int
) -> list[Cycle]:
    """پالایش تکراری تا رسیدن به درجه ۴."""
    if current_degree >= max_degree:
        return cycles  # توقف
    
    # انتقال به تایم پایین‌تر
    next_tf = get_next_timeframe(current_degree)
    
    for cycle in cycles:
        cycle.sub_cycles = refine_cycle(
            candles_by_tf[next_tf], cycle
        )
    
    return iterative_refinement(
        candles_by_tf, cycles, current_degree + 1, max_degree
    )
