def build_cycle_candidates(pivots: list[Pivot], candles: list[Candle]) -> list[Cycle]:
    """ساخت کاندیدهای سیکل از پیوت‌ها."""
    candidates = []
    
    # سیکل ایده‌آل: ۸ پیوت (۵ موج صعودی + ۳ موج نزولی)
    for i in range(len(pivots) - 7):
        wave_points = pivots[i:i+8]
        if is_alternating(wave_points):  # high-low-high-low...
            candidates.append(Cycle(points=wave_points, type="ideal"))
    
    # سیکل ترمینال: ۸ پیوت با نقض قانون ۳
    for i in range(len(pivots) - 7):
        wave_points = pivots[i:i+8]
        if is_alternating(wave_points) and violates_rule_3(wave_points):
            candidates.append(Cycle(points=wave_points, type="terminal"))
    
    # سیکل آنتی‌سیکل: ۸ پیوت با نقض قانون ۱
    for i in range(len(pivots) - 7):
        wave_points = pivots[i:i+8]
        if is_alternating(wave_points) and violates_rule_1(wave_points):
            candidates.append(Cycle(points=wave_points, type="anti_cycle"))
    
    return candidates
