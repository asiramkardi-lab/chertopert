def generate_scenarios(cycles: list[Cycle]) -> list[Scenario]:
    """تولید سناریوهای ممکن برای آینده."""
    scenarios = []
    
    # سناریو ۱: ادامه روند اصلی (ادامه صعود)
    if cycles[-1].type in ["ideal", "terminal", "diagonal"]:
        scenarios.append(Scenario(
            name="uptrend_continuation",
            description="Uptrend resumes after correction",
            probability=0.6,
            target=compute_tmv(cycles[-1]),
            stop=compute_stop_loss(cycles[-1])
        ))
    
    # سناریو ۲: ریزش (شروع روند نزولی)
    if cycles[-1].wave_5.is_extended:
        scenarios.append(Scenario(
            name="downtrend_start",
            description="Sharp reversal after extended wave 5",
            probability=0.4,
            target=compute_abc_target(cycles[-1]),
            stop=compute_stop_loss(cycles[-1])
        ))
    
    # سناریو ۳: رنج (خنثی)
    scenarios.append(Scenario(
        name="range_bound",
        description="Sideways movement; wait for breakout",
        probability=0.3,
        target=None,
        stop=None
    ))
    
    return scenarios
