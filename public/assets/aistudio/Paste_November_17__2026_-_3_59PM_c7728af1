def validate_cycle(cycle: Cycle) -> ValidationResult:
    """اعتبارسنجی سیکل با ترتیب اولویت."""
    waves = cycle.to_waves()
    
    # اولویت ۱: سیکل ایده‌آل
    if validate_ideal_cycle(waves).valid:
        return ValidationResult(valid=True, type="ideal", confidence=0.9)
    
    # اولویت ۲: الگوی قطر
    if validate_diagonal(waves).valid:
        return ValidationResult(valid=True, type="diagonal", confidence=0.8)
    
    # اولویت ۳: ترمینال / آنتی‌سیکل
    if validate_terminal(waves).valid:
        return ValidationResult(valid=True, type="terminal", confidence=0.8)
    if validate_anti_cycle(waves).valid:
        return ValidationResult(valid=True, type="anti_cycle", confidence=0.75)
    
    # اولویت ۴: زیگزاگ
    if validate_zigzag(waves).valid:
        return ValidationResult(valid=True, type="zigzag", confidence=0.7)
    
    # اولویت ۵: فلت
    if validate_flat(waves).valid:
        return ValidationResult(valid=True, type="flat", confidence=0.65)
    
    # اولویت ۶: مثلث
    if validate_triangle(waves).valid:
        return ValidationResult(valid=True, type="triangle", confidence=0.7)
    
    # اولویت ۷: ترکیبی
    if validate_complex(waves).valid:
        return ValidationResult(valid=True, type="complex", confidence=0.5)
    
    return ValidationResult(valid=False, reason="No valid pattern")
