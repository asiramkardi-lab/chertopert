    warnings.extend(ext_warnings)
    if extension:
        notes.append(f"Extension: {extension} ({severity})")
    
    # Step 2: TMV
    tmv = compute_tmv(req)
    notes.append(f"TMV: Prime={tmv.prime}, Ideal={tmv.ideal}, Alternate={tmv.alternate}")
    
    # Step 3: PRZ
    prz = identify_prz(req, "wave_2")
    if prz:
        notes.append(f"PRZ: {prz.level*100}% ({prz.context})")
    
    # Step 4: Trailing stop
    trailing = None
    if req.current_price is not None:
        trailing = recommend_trailing_stop(req.current_price, tmv, extension)
        notes.append(f"Trailing: {trailing}")
    
    # Confidence
    confidence = 0.8
    if extension == "wave_5":
        confidence = 0.9
        warnings.append("Wave 5 extension: high reversal risk")
    elif extension == "wave_3":
        confidence = 0.85
    elif extension is None:
