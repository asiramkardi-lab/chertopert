from app.schemas.extension import ExtensionRequest, TMVResult

def compute_tmv(req: ExtensionRequest) -> TMVResult:
    """Compute TMV Prime/Ideal/Alternate."""
    x = req.wave_1.start_price
    y = req.wave_1.end_price
    z = req.wave_2.end_price
    
    direction = "up" if y > x else "down"
    wave_length = abs(y - x)
    sign = 1 if direction == "up" else -1
    
    prime = y  # Wave 1 high
    ideal = z + sign * wave_length * 1.0
    alternate = z + sign * wave_length * 1.618
    
    return TMVResult(
        prime=round(prime, 4),
        ideal=round(ideal, 4),
        alternate=round(alternate, 4),
        direction=direction
    )
```

