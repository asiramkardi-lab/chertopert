from app.schemas.extension import ExtensionResponse

def recommend_trailing_stop(
    current_price: float,
    tmv: 'TMVResult',
    extension: str | None
) -> str:
    """Recommend trailing stop based on TMV hits."""
    if extension == "wave_5":
        return "immediate_profit_taking"
    
    if current_price >= tmv.alternate:
        return "below_100%_projection"
    elif current_price >= tmv.ideal:
        return "below_61.8%_retracement"
    elif current_price >= tmv.prime:
        return "below_wave_2"
    
    return "below_wave_2_initial"
