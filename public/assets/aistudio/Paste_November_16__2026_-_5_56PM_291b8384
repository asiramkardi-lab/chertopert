from app.schemas.extension import ExtensionRequest, Wave, PRZResult

PRZ_LEVELS = {
    "wave_2": [0.618, 0.786],
    "wave_4": [0.382, 0.50]
}

def identify_prz(req: ExtensionRequest, wave_label: str) -> PRZResult | None:
    """Identify PRZ for wave 2 or 4."""
    if wave_label == "wave_2":
        base = req.wave_1
        target_wave = req.wave_2
    elif wave_label == "wave_4":
        base = req.wave_3
        target_wave = req.wave_4
    else:
        return None
    
    retracement = target_wave.length / base.length if base.length > 0 else 0
    
    for level in PRZ_LEVELS[wave_label]:
        if abs(retracement - level) < 0.05:  # 5% tolerance
            if level == 0.786:
                context = "with acceleration"
            elif level == 0.618:
                context = "ideal"
            elif level == 0.382:
                context = "shallow (wave 4)"
            else:
                context = "standard"
            return PRZResult(level=level, price=target_wave.end_price, context=context)
    
    return None
