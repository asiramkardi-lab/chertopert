})

const stopDescription = computed(() => {
  const s = props.result?.trailing_stop
  if (s === 'immediate_profit_taking') return 'Wave 5 extension detected; reversal imminent.'
  if (s === 'below_100%_projection') return 'Alternate hit; lock in profits.'
  if (s === 'below_61.8%_retracement') return 'Ideal hit; trail stop higher.'
  if (s === 'below_wave_2') return 'Prime hit; move stop to below wave 2.'
  return 'Initial stop below wave 2.'
})

const stopIcon = computed(() => {
  const s = props.result?.trailing_stop
  if (s === 'immediate_profit_taking') return 'i-lucide-alert-octagon'
  if (s === 'below_100%_projection') return 'i-lucide-trending-down'
  return 'i-lucide-shield'
})
