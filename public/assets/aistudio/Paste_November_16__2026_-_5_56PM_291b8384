from app.schemas.extension import ExtensionRequest

def detect_extension(req: ExtensionRequest) -> tuple[str | None, str | None, list[str]]:
    """Detect wave extension (1, 3, or 5)."""
    warnings = []
    
    w1, w2, w3 = req.wave_1, req.wave_2, req.wave_3
    w4 = req.wave_4
    
    # Wave 3 extension: w3 > 161.8% of w1 + w4 < 38.2% of w3
    ratio_31 = w3.length / w1.length if w1.length > 0 else 0
    ratio_43 = w4.length / w3.length if w3.length > 0 else 0
    
    if ratio_31 >= 1.618 and ratio_43 < 0.382:
        if ratio_31 >= 2.618:
            return "wave_3", "severe", ["Wave 3 severe extension"]
        elif ratio_31 >= 2.0:
            return "wave_3", "strong", ["Wave 3 strong extension"]
        else:
            return "wave_3", "moderate", []
    
    # Wave 5 extension
    if req.wave_5:
        w5 = req.wave_5
        ratio_53 = w5.length / w3.length if w3.length > 0 else 0
        if ratio_53 >= 1.618:
            if ratio_53 >= 2.0:
                return "wave_5", "strong", ["Wave 5 strong extension: expect sharp reversal"]
            return "wave_5", "moderate", []
    
    # Wave 1 extension: w2 < 38.2% of w1
    ratio_21 = w2.length / w1.length if w1.length > 0 else 0
    if ratio_21 < 0.382:
        # Check if w3 is short (< 100% w1)
        if ratio_31 < 1.0:
            return "wave_1", "moderate", ["Wave 1 extension confirmed"]
    
    return None, None, []
```

